<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctl="using:WhisperNotes.App.Views.Controls"
             xmlns:vm="using:WhisperNotes.App.ViewModels"
             xmlns:dd="using:WhisperNotes.App.DesignData"
             mc:Ignorable="d"
             x:Class="WhisperNotes.App.Views.InputSettingsView"
             x:DataType="vm:InputSettingsViewModel"
             d:DataContext="{x:Static dd:InputSettingsDesignData.ViewModel}">

  <Grid Background="{DynamicResource SurfaceBase}" RowDefinitions="Auto,*">
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceRaised}"
            BorderBrush="{DynamicResource BorderDefault}"
            BorderThickness="0,0,0,1"
            Padding="{DynamicResource PadPane}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space4}">
        <StackPanel Grid.Column="0" Spacing="{DynamicResource Space2}">
          <TextBlock Classes="h1" Text="Inputs" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     TextTrimming="None"
                     Text="Choose every audio source to capture. Enabled sources are transcribed in parallel into the same session." />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="{DynamicResource Space2}">
          <!-- Applications come and go far faster than hardware does, so the label has to promise
               that this button re-reads the running process list too, not just the endpoints. -->
          <Button Classes="subtle"
                  Content="Refresh devices &amp; apps"
                  Command="{Binding RefreshCommand}"
                  ToolTip.Tip="Re-read the audio endpoints and the applications currently playing audio"
                  AutomationProperties.Name="Refresh devices and running applications" />
          <Button Classes="accent"
                  Content="Add input"
                  Command="{Binding AddSourceCommand}"
                  IsEnabled="{Binding HasAvailableChannels}" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="920"
                  HorizontalAlignment="Stretch"
                  Margin="{DynamicResource PadPane}"
                  Spacing="{DynamicResource Space4}">

        <Border Classes="card" Padding="{DynamicResource PadCard}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space3}">
            <ctl:StatusDot Grid.Column="0" Kind="Ok" Size="{DynamicResource DotSizeLg}" />
            <StackPanel Grid.Column="1" Spacing="{DynamicResource Space1}">
              <TextBlock Classes="label" Text="{Binding SummaryText}" />
              <TextBlock Classes="caption"
                         TextWrapping="Wrap"
                         TextTrimming="None"
                         Text="Loopback hears system playback such as Teams. Microphone captures your local voice or another physical input. An application input hears one running app on its own, so two apps can be transcribed side by side without either bleeding into the other." />
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="callout warning" IsVisible="{Binding HasMissingEnabledSources}">
          <TextBlock Text="One or more enabled inputs are unavailable. Reconnect the device or reopen the application, choose a replacement, or disable those inputs before recording." />
        </Border>

        <!-- Not an error: the recording still happens, it is just wider than the user asked for.
             The copy comes from ProcessLoopbackSupport so the explanation and the check that
             produced it cannot drift apart. -->
        <Border Classes="callout warning" IsVisible="{Binding HasProcessLoopbackWarning}">
          <StackPanel Spacing="{DynamicResource Space2}">
            <TextBlock Text="{Binding ProcessLoopbackWarningText}" />
            <TextBlock Text="Nothing is lost — those inputs record the whole system output instead, so the app you wanted is captured along with everything else playing." />
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Sources}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="{DynamicResource Space3}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InputSourceViewModel">
              <Border Classes="card" Padding="{DynamicResource PadPane}">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="{DynamicResource Space3}"
                      RowSpacing="{DynamicResource Space3}">
                  <CheckBox Grid.Row="0"
                            Grid.Column="0"
                            Grid.RowSpan="2"
                            VerticalAlignment="Top"
                            Margin="0,5,0,0"
                            IsChecked="{Binding IsEnabled}"
                            ToolTip.Tip="Include this source in the next recording"
                            AutomationProperties.Name="Enable input" />

                  <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource Space3}">
                    <ctl:LabeledField Grid.Column="0" Header="Display name">
                      <TextBox Text="{Binding DisplayName}"
                               PlaceholderText="e.g. Room microphone"
                               AutomationProperties.Name="Input display name" />
                    </ctl:LabeledField>

                    <ctl:LabeledField Grid.Column="1" Header="Audio device or application">
                      <ComboBox ItemsSource="{Binding AvailableChannels}"
                                SelectedItem="{Binding SelectedChannel}"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="Choose a device or application"
                                AutomationProperties.Name="Audio device or application">
                        <!--
                          The list now mixes endpoints with running applications, so the first row of
                          each kind carries its group header — otherwise "Microsoft Teams" sits in the
                          same undifferentiated run as "Speakers (Realtek)" and the two read as the
                          same sort of thing, which is the whole misunderstanding this page exists to
                          prevent. SelectionBoxItemTemplate repeats the row WITHOUT the header, since
                          it outranks ItemTemplate for the closed control: without it the collapsed
                          box would print the group heading above the chosen device.
                        -->
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:ChannelOptionViewModel">
                            <StackPanel Spacing="{DynamicResource Space1}">
                              <TextBlock Classes="section"
                                         Text="{Binding GroupHeader}"
                                         IsVisible="{Binding ShowGroupHeader}"
                                         TextWrapping="Wrap" />
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space3}">
                                <TextBlock Grid.Column="0" Text="{Binding Summary}" />
                                <TextBlock Grid.Column="1" Classes="caption" Text="{Binding KindLabel}" />
                              </Grid>
                            </StackPanel>
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.SelectionBoxItemTemplate>
                          <DataTemplate x:DataType="vm:ChannelOptionViewModel">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space3}">
                              <TextBlock Grid.Column="0" Text="{Binding Summary}" />
                              <TextBlock Grid.Column="1" Classes="caption" Text="{Binding KindLabel}" />
                            </Grid>
                          </DataTemplate>
                        </ComboBox.SelectionBoxItemTemplate>
                      </ComboBox>
                    </ctl:LabeledField>
                  </Grid>

                  <Button Grid.Row="0"
                          Grid.Column="2"
                          Classes="ghost"
                          Content="Remove"
                          Command="{Binding RemoveCommand}"
                          Foreground="{DynamicResource DangerBase}"
                          AutomationProperties.Name="Remove input" />

                  <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,*"
                        ColumnSpacing="{DynamicResource Space3}">
                    <Border Grid.Column="0" Classes="badge accent">
                      <TextBlock Text="{Binding KindLabel}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource Space1}">
                      <TextBlock Classes="caption"
                                 Text="{Binding AvailabilityText}"
                                 Foreground="{DynamicResource WarningBase}"
                                 TextWrapping="Wrap"
                                 TextTrimming="None" />
                      <TextBlock Classes="caption mono"
                                 Text="{Binding DeviceId}"
                                 TextWrapping="NoWrap"
                                 ToolTip.Tip="{Binding DeviceId}" />
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="card"
                Padding="{DynamicResource PadPane}"
                IsVisible="{Binding HasNoSources}">
          <ctl:EmptyState Heading="No inputs configured"
                          Body="Connect an audio endpoint or open the application you want to capture, refresh the list, then add it here." />
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
