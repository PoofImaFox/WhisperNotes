<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WhisperNotes.App.ViewModels"
             xmlns:views="using:WhisperNotes.App.Views"
             xmlns:ctl="using:WhisperNotes.App.Views.Controls"
             mc:Ignorable="d"
             x:Class="WhisperNotes.App.Views.NotesWorkspaceView"
             x:DataType="vm:NotesWorkspaceViewModel">

  <UserControl.Styles>
    <!--
      The library rows and the assistant tab strip both used to restate the selection idiom here
      — Border.noterow at its own padding and Button.tab.on byte-for-byte identical to
      NoteEditorView's Button.mode.on. Both are Border.rowitem / Button.selected in App.axaml now.
    -->
    <Style Selector="Button.action">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    </Style>
    <Style Selector="Button.action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AiAccentMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AiAccent}" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <Grid ColumnDefinitions="252,Auto,*,Auto,Auto">

      <!-- ================================================================
           LIBRARY
           ================================================================ -->
      <Border Grid.Column="0"
              Background="{DynamicResource SurfaceSunken}"
              BorderBrush="{DynamicResource BorderDefault}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

          <ctl:PaneHeader Grid.Row="0" Header="NOTES">
            <StackPanel Classes="actions">
              <Button Classes="ghost"
                      Content="Folder"
                      Command="{Binding OpenNotesFolderCommand}"
                      ToolTip.Tip="Reveal the note documents folder in Explorer" />
              <Button Classes="ghost" Content="Reload" Command="{Binding ReloadCommand}" />
            </StackPanel>
          </ctl:PaneHeader>

          <Grid Grid.Row="1"
                ColumnDefinitions="*,Auto"
                Margin="{DynamicResource PadPaneField}"
                ColumnSpacing="{DynamicResource Space2}">
            <Button Grid.Column="0"
                    Classes="accent"
                    HorizontalAlignment="Stretch"
                    Content="New note"
                    Command="{Binding NewNoteCommand}" />
            <Button Grid.Column="1"
                    Classes="subtle"
                    Content="From meeting…"
                    Command="{Binding NewFromMeetingCommand}"
                    ToolTip.Tip="Seed a note from a finished recording's transcript" />
          </Grid>

          <TextBox Grid.Row="2"
                   Classes="panesearch"
                   PlaceholderText="Search titles, projects and text…"
                   Text="{Binding SearchText}"
                   AutomationProperties.Name="Search notes" />

          <!-- inline rename + delete confirmation, in place of a modal dialog -->
          <StackPanel Grid.Row="3" Margin="{DynamicResource PadPaneField}" Spacing="{DynamicResource Space2}">
            <Border Background="{DynamicResource SurfaceBase}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSm}"
                    Padding="{DynamicResource PadTight}"
                    IsVisible="{Binding HasTranscriptSpeakers}">
              <StackPanel Spacing="{DynamicResource Space2}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space2}">
                  <ctl:LabeledField Grid.Column="0" Header="Transcript speakers">
                    <ComboBox ItemsSource="{Binding TranscriptSpeakers}"
                              SelectedItem="{Binding SelectedTranscriptSpeaker}"
                              MinWidth="120"
                              AutomationProperties.Name="Transcript speaker" />
                  </ctl:LabeledField>
                  <Button Grid.Column="1"
                          Classes="ghost"
                          VerticalAlignment="Bottom"
                          Content="Rename"
                          Command="{Binding BeginTranscriptSpeakerRenameCommand}" />
                </Grid>

                <ctl:InlineTextPrompt IsVisible="{Binding IsRenamingTranscriptSpeaker}"
                                      Text="{Binding TranscriptSpeakerRenameText}"
                                      Placeholder="Person's name"
                                      AccessibleName="New speaker name"
                                      CommitCommand="{Binding CommitTranscriptSpeakerRenameCommand}"
                                      CancelCommand="{Binding CancelTranscriptSpeakerRenameCommand}" />
              </StackPanel>
            </Border>

            <ctl:InlineTextPrompt IsVisible="{Binding IsRenaming}"
                                  Label="Rename"
                                  Text="{Binding RenameText}"
                                  AccessibleName="New title"
                                  CommitCommand="{Binding CommitRenameCommand}"
                                  CancelCommand="{Binding CancelRenameCommand}" />

            <Border Classes="callout danger" IsVisible="{Binding IsDeleteConfirmOpen}">
              <StackPanel Spacing="{DynamicResource Space2}">
                <TextBlock Classes="caption" Text="{Binding DeleteConfirmText}" />
                <StackPanel Classes="actions">
                  <Button Classes="danger" Content="Delete" Command="{Binding ConfirmDeleteCommand}" />
                  <Button Classes="subtle" Content="Keep" Command="{Binding CancelDeleteCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <ListBox Grid.Row="4"
                   Margin="6,0,6,0"
                   Background="Transparent"
                   BorderThickness="0"
                   ItemsSource="{Binding Documents}"
                   SelectedItem="{Binding SelectedDocument}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="Note library">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="MinHeight" Value="0" />
              </Style>
              <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
              </Style>
            </ListBox.Styles>

            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:NoteListItemViewModel">
                <Border Classes="rowitem"
                        Classes.selected="{Binding $parent[ListBoxItem].IsSelected}"
                        AutomationProperties.Name="{Binding Title}">
                  <StackPanel Spacing="{DynamicResource Space1}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space2}">
                      <ctl:StatusDot Grid.Column="0"
                                     Kind="Ai"
                                     IsVisible="{Binding IsAiTouched}"
                                     ToolTip.Tip="The most recent change came from an AI action" />
                      <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="Medium" />
                    </Grid>

                    <TextBlock Classes="caption" Text="{Binding PreviewText}" IsVisible="{Binding HasPreview}" />

                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space3}">
                      <Border Classes="badge" IsVisible="{Binding HasProject}">
                        <TextBlock Text="{Binding ProjectText}" />
                      </Border>
                      <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding UpdatedText}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- The export block stays inline as PaneFooter.Content: four Click handlers and one
               call site, so it is not worth a component of its own. -->
          <ctl:PaneFooter Grid.Row="5" Summary="{Binding LibrarySummary}">
            <ctl:PaneFooter.Actions>
              <StackPanel Classes="actions">
                <Button Classes="ghost" Content="Rename" Command="{Binding BeginRenameCommand}" />
                <Button Classes="ghost" Content="Delete" Command="{Binding RequestDeleteCommand}" />
              </StackPanel>
            </ctl:PaneFooter.Actions>

            <StackPanel Spacing="{DynamicResource Space2}">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource Space1}">
                <TextBlock Grid.Column="0"
                           Classes="caption"
                           Text="Export note"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Classes="ghost"
                        Content="MD"
                        IsEnabled="{Binding CanExportNote}"
                        Click="OnExportMarkdownClick"
                        ToolTip.Tip="Export the open note as Markdown" />
                <Button Grid.Column="2"
                        Classes="ghost"
                        Content="HTML"
                        IsEnabled="{Binding CanExportNote}"
                        Click="OnExportHtmlClick"
                        ToolTip.Tip="Export the open note as a standalone HTML file" />
                <Button Grid.Column="3"
                        Classes="ghost"
                        Content="PDF"
                        IsEnabled="{Binding CanExportNote}"
                        Click="OnExportPdfClick"
                        ToolTip.Tip="Export the open note as a PDF" />
              </Grid>

              <Button Classes="subtle"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Padding="{DynamicResource PadTight}"
                      Content="Export all for Obsidian (.zip)"
                      IsEnabled="{Binding CanExportLibrary}"
                      Click="OnExportObsidianClick"
                      ToolTip.Tip="Export the entire note library, including notes hidden by the current search" />
            </StackPanel>
          </ctl:PaneFooter>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="3" Background="{DynamicResource BorderSubtle}" ResizeDirection="Columns" />

      <!-- ================================================================
           EDITOR
           ================================================================ -->
      <views:NoteEditorView Grid.Column="2" DataContext="{Binding Editor}" />

      <GridSplitter Grid.Column="3"
                    Width="3"
                    Background="{DynamicResource BorderSubtle}"
                    ResizeDirection="Columns"
                    IsVisible="{Binding Editor.IsSidePaneOpen}" />

      <!-- ================================================================
           ASSISTANT + HISTORY RAIL
           ================================================================ -->
      <Border Grid.Column="4"
              Width="336"
              Background="{DynamicResource SurfaceBase}"
              BorderBrush="{DynamicResource BorderDefault}"
              BorderThickness="1,0,0,0"
              IsVisible="{Binding Editor.IsSidePaneOpen}">
        <Grid RowDefinitions="Auto,Auto,*">

          <!-- tab strip -->
          <Border Grid.Row="0" Classes="toolbar">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource Space2}">
              <Button Grid.Column="0"
                      Classes="ghost"
                      Classes.selected="{Binding Editor.IsAssistantPane}"
                      Content="Assistant"
                      Command="{Binding Editor.ShowAssistantCommand}" />
              <Button Grid.Column="1"
                      Classes="ghost"
                      Classes.selected="{Binding Editor.IsHistoryPane}"
                      Content="History"
                      Command="{Binding Editor.ShowHistoryCommand}" />
              <Button Grid.Column="3"
                      Classes="icon"
                      Command="{Binding ToggleAiSettingsCommand}"
                      ToolTip.Tip="Assistant settings">
                <ctl:Icon Data="{DynamicResource IconSettings}" />
              </Button>
              <Button Grid.Column="4"
                      Classes="icon"
                      Command="{Binding Editor.ToggleSidePaneCommand}"
                      ToolTip.Tip="Hide this panel">
                <ctl:Icon Data="{DynamicResource IconClose}" />
              </Button>
            </Grid>
          </Border>

          <views:AiSettingsView Grid.Row="1"
                                DataContext="{Binding AiSettings}"
                                IsVisible="{Binding $parent[views:NotesWorkspaceView].((vm:NotesWorkspaceViewModel)DataContext).IsAiSettingsOpen}" />

          <!-- ================= assistant ================= -->
          <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto" IsVisible="{Binding Editor.IsAssistantPane}">

            <StackPanel Grid.Row="0" Margin="{DynamicResource PadCard}" Spacing="{DynamicResource Space2}">
              <TextBlock Classes="caption" Text="{Binding AiSettings.ProviderSummary}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="caption"
                         Foreground="{DynamicResource WarningBase}"
                         TextWrapping="Wrap"
                         TextTrimming="None"
                         Text="{Binding AiSettings.ConfigurationHint}"
                         IsVisible="{Binding AiSettings.HasConfigurationHint}" />

              <TextBox Text="{Binding Editor.CustomInstruction}"
                       PlaceholderText="Instruction for “Custom instruction…”"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MaxHeight="86"
                       AutomationProperties.Name="Custom instruction" />

              <TextBlock Classes="caption">
                <Run Text="Actions run against the" />
                <Run Text="{Binding Editor.TargetText}" FontWeight="SemiBold" />
                <Run Text="and land in a preview first." />
              </TextBlock>
            </StackPanel>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Editor.ActionGroups}" Margin="10,0,10,10">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:AiActionGroupViewModel">
                    <StackPanel Spacing="{DynamicResource Space2}" Margin="0,0,0,10">
                      <TextBlock Classes="section" Text="{Binding CategoryText}" />
                      <ItemsControl ItemsSource="{Binding Actions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:AiActionViewModel">
                            <Button Classes="ghost action"
                                    Margin="0,0,0,3"
                                    Command="{Binding RunCommand}"
                                    ToolTip.Tip="{Binding TooltipText}"
                                    AutomationProperties.Name="{Binding Name}">
                              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Space3}">
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" VerticalAlignment="Center" TextTrimming="None" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Classes="caption"
                                           VerticalAlignment="Center"
                                           Text="running…"
                                           IsVisible="{Binding IsRunning}" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- ================= preview → apply ================= -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceSunken}"
                    BorderBrush="{DynamicResource AiAccent}"
                    BorderThickness="0,2,0,0"
                    MaxHeight="420"
                    IsVisible="{Binding Editor.HasPreview}">
              <Grid RowDefinitions="Auto,*,Auto,Auto">
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="{DynamicResource PadCard}"
                      ColumnSpacing="{DynamicResource Space2}">
                  <TextBlock Grid.Column="0"
                             Classes="label"
                             Foreground="{DynamicResource AiAccent}"
                             Text="{Binding Editor.PreviewHeader}" />
                  <Button Grid.Column="1"
                          Classes="danger"
                          Padding="{DynamicResource PadTight}"
                          Content="Stop"
                          Command="{Binding Editor.StopCommand}"
                          IsVisible="{Binding Editor.IsRunning}" />
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Padding="12,0,12,8"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                  <SelectableTextBlock Text="{Binding Editor.PreviewText}"
                                       TextWrapping="Wrap"
                                       FontFamily="{DynamicResource FontFamilyMono}"
                                       FontSize="{StaticResource FontSizeSm}"
                                       Foreground="{DynamicResource TextPrimary}" />
                </ScrollViewer>

                <TextBlock Grid.Row="2"
                           Classes="caption"
                           Margin="12,0,12,6"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           Foreground="{DynamicResource WarningBase}"
                           Text="{Binding Editor.PreviewNote}"
                           IsVisible="{Binding Editor.PreviewNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <StackPanel Grid.Row="3" Classes="actions" Margin="{DynamicResource PadCard}">
                  <Button Classes="accent"
                          Content="Apply"
                          Command="{Binding Editor.ApplyPreviewCommand}"
                          ToolTip.Tip="Replace the target text. The previous version goes straight into History." />
                  <Button Classes="subtle"
                          Content="Insert below"
                          Command="{Binding Editor.InsertPreviewCommand}"
                          ToolTip.Tip="Keep the original and add this underneath it" />
                  <Button Classes="ghost" Content="Copy" Command="{Binding Editor.CopyPreviewCommand}" />
                  <Button Classes="ghost" Content="Discard" Command="{Binding Editor.DiscardPreviewCommand}" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>

          <!-- ================= history ================= -->
          <views:NoteRevisionsView Grid.Row="2"
                                   DataContext="{Binding Editor}"
                                   IsVisible="{Binding IsHistoryPane}" />
        </Grid>
      </Border>
    </Grid>

    <!-- ================================================================
         MEETING PICKER — an overlay, so it never resizes the panes beneath
         ================================================================ -->
    <Border Background="{DynamicResource ScrimOverlay}" IsVisible="{Binding IsMeetingPickerOpen}">
      <Border Classes="pane"
              Width="520"
              MaxHeight="460"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="{DynamicResource SurfaceOverlay}">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource Space4}">
          <StackPanel Grid.Row="0" Spacing="{DynamicResource Space1}">
            <TextBlock Classes="h2" Text="New note from a meeting" TextTrimming="None" />
            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       TextTrimming="None"
                       Text="The session's rendered transcript becomes the note's starting text, and the note remembers which meeting it came from." />
          </StackPanel>

          <ListBox Grid.Row="1"
                   Background="Transparent"
                   BorderThickness="0"
                   ItemsSource="{Binding Meetings}"
                   SelectedItem="{Binding SelectedMeeting}"
                   AutomationProperties.Name="Finished meetings">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:MeetingPickViewModel">
                <StackPanel Spacing="{DynamicResource Space1}" Margin="0,2">
                  <TextBlock Text="{Binding Title}" FontWeight="Medium" />
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space3}">
                    <TextBlock Classes="caption" Text="{Binding WhenText}" />
                    <TextBlock Classes="caption" Text="{Binding DurationText}" />
                    <TextBlock Classes="caption" Text="{Binding ProjectText}" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Primary first, like every other confirm/cancel pair in the app: this row used to
               put Cancel on the left, so the same click landed on opposite buttons here and in
               the library's rename and delete prompts. -->
          <StackPanel Grid.Row="2" Classes="actions" HorizontalAlignment="Right">
            <TextBlock Classes="caption" Text="loading…" VerticalAlignment="Center" IsVisible="{Binding IsMeetingsLoading}" />
            <Button Classes="accent" Content="Create note" Command="{Binding CreateFromMeetingCommand}" />
            <Button Classes="subtle" Content="Cancel" Command="{Binding CloseMeetingPickerCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>
  </Panel>
</UserControl>
