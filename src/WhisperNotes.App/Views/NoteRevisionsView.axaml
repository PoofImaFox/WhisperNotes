<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctl="using:WhisperNotes.App.Views.Controls"
             xmlns:vm="using:WhisperNotes.App.ViewModels"
             mc:Ignorable="d"
             x:Class="WhisperNotes.App.Views.NoteRevisionsView"
             x:DataType="vm:NoteEditorViewModel">

  <UserControl.Styles>
    <!-- Diff rows: a full-width tinted strip per line, mono, no wrapping. -->
    <Style Selector="Border.diffrow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0,0,6,0" />
    </Style>
    <Style Selector="Border.diffrow.added">
      <Setter Property="Background" Value="{DynamicResource DiffAddBg}" />
    </Style>
    <Style Selector="Border.diffrow.removed">
      <Setter Property="Background" Value="{DynamicResource DiffRemoveBg}" />
    </Style>

    <Style Selector="Border.diffrow TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
      <Setter Property="TextTrimming" Value="None" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="Border.diffrow.added TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource DiffAddFg}" />
    </Style>
    <Style Selector="Border.diffrow.removed TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource DiffRemoveFg}" />
    </Style>
    <Style Selector="Border.diffrow.elision TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto,Auto">

    <!-- ============ header ============ -->
    <Grid Grid.Row="0"
          ColumnDefinitions="*,Auto"
          Margin="{DynamicResource PadCard}"
          ColumnSpacing="{DynamicResource Space2}">
      <TextBlock Grid.Column="0"
                 Classes="caption"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"
                 TextTrimming="None"
                 Text="Every change — yours and the assistant's — leaves the previous text here." />
      <Button Grid.Column="1"
              Classes="icon"
              Command="{Binding ReloadHistoryCommand}"
              ToolTip.Tip="Reload history">
        <ctl:Icon Data="{DynamicResource IconRefresh}" />
      </Button>
    </Grid>

    <!-- ============ revision list ============ -->
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <ctl:EmptyState Margin="{DynamicResource PadCard}"
                        IsVisible="{Binding !HasRevisions}"
                        Body="No history yet. The first edit after this note was created writes its original text here." />

        <ListBox ItemsSource="{Binding Revisions}"
                 SelectedItem="{Binding SelectedRevision}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="4,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Revision history">
          <ListBox.Styles>
            <!-- The row draws its own selection, so the container must not draw a second one. -->
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,1" />
              <Setter Property="MinHeight" Value="0" />
            </Style>
            <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="Padding" Value="0" />
            </Style>
          </ListBox.Styles>

          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:NoteRevisionViewModel">
              <Border Classes="rowitem"
                      Classes.selected="{Binding $parent[ListBoxItem].IsSelected}"
                      ToolTip.Tip="{Binding TooltipText}"
                      AutomationProperties.Name="{Binding Label}">
                <StackPanel Spacing="{DynamicResource Space1}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space2}">
                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="Medium" />
                    <TextBlock Grid.Column="1"
                               Classes="caption mono"
                               VerticalAlignment="Center"
                               Text="{Binding StatText}"
                               IsVisible="{Binding HasStat}" />
                  </Grid>

                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space3}">
                    <Border Classes="badge" IsVisible="{Binding !IsAi}">
                      <TextBlock Text="{Binding OriginText}" />
                    </Border>
                    <Border Classes="badge ai" IsVisible="{Binding IsAi}">
                      <TextBlock Text="{Binding OriginText}" />
                    </Border>
                    <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding RelativeText}" />
                    <TextBlock Classes="caption"
                               VerticalAlignment="Center"
                               Text="original"
                               IsVisible="{Binding IsOriginal}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </ScrollViewer>

    <!-- ============ unified diff ============ -->
    <Border Grid.Row="2"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="0,1,0,0"
            Background="{DynamicResource SurfaceSunken}"
            MaxHeight="300"
            IsVisible="{Binding HasSelectedRevision}">
      <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Margin="{DynamicResource PadCard}"
              ColumnSpacing="{DynamicResource Space2}">
          <StackPanel Grid.Column="0" Spacing="{DynamicResource Space1}">
            <TextBlock Classes="label" Text="{Binding DiffHeaderText}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="caption mono" Text="{Binding DiffSummaryText}" />
          </StackPanel>
          <Button Grid.Column="1"
                  Classes="icon"
                  Command="{Binding ClearRevisionSelectionCommand}"
                  ToolTip.Tip="Close the diff">
            <ctl:Icon Data="{DynamicResource IconClose}" />
          </Button>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0,0,0,8">
          <ItemsControl ItemsSource="{Binding DiffLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:DiffLineViewModel">
                <Border Classes="diffrow"
                        Classes.added="{Binding IsAdded}"
                        Classes.removed="{Binding IsRemoved}"
                        Classes.elision="{Binding IsSeparator}">
                  <Grid ColumnDefinitions="34,10,*">
                    <TextBlock Grid.Column="0"
                               Text="{Binding LineNumberText}"
                               TextAlignment="Right"
                               Opacity="0.55"
                               Margin="0,0,6,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Marker}" />
                    <TextBlock Grid.Column="2" Text="{Binding Text}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- ============ restore ============ -->
    <Border Grid.Row="3"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="0,1,0,0"
            Padding="{DynamicResource PadCard}"
            IsVisible="{Binding HasSelectedRevision}">
      <StackPanel Spacing="{DynamicResource Space3}">
        <Button Classes="accent"
                HorizontalAlignment="Stretch"
                Content="Restore this version"
                Command="{Binding RestoreRevisionCommand}"
                ToolTip.Tip="Makes this snapshot the note again. The version you are leaving is kept, so a restore is itself undoable." />
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   TextTrimming="None"
                   Text="Restoring keeps the version you are leaving, so you can always come back." />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
