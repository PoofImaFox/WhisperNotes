<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WhisperNotes.App.ViewModels"
             xmlns:views="using:WhisperNotes.App.Views"
             xmlns:ctl="using:WhisperNotes.App.Views.Controls"
             xmlns:dd="using:WhisperNotes.App.DesignData"
             mc:Ignorable="d"
             x:Class="WhisperNotes.App.Views.NotesBrowserView"
             x:DataType="vm:NotesBrowserViewModel"
             d:DataContext="{x:Static dd:DesignTime.Browser}">

  <UserControl.Resources>

    <views:UpperCaseConverter x:Key="UpperCase" />

    <!-- Expander glyph: kept, but drawn as a quiet muted chevron rather than Fluent's. -->
    <ControlTheme x:Key="NotesTreeChevronTheme" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent">
            <Path Name="Glyph"
                  Data="M 0,0 L 4,4 L 0,8"
                  Stroke="{DynamicResource TextMuted}"
                  StrokeThickness="1.3"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  RenderTransformOrigin="50%,50%" />
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:checked /template/ Path#Glyph">
        <Setter Property="RenderTransform">
          <RotateTransform Angle="90" />
        </Setter>
      </Style>

      <Style Selector="^:pointerover /template/ Path#Glyph">
        <Setter Property="Stroke" Value="{DynamicResource TextPrimary}" />
      </Style>
    </ControlTheme>

    <!--
      A hand-written theme rather than a patch over Fluent's: Fluent paints its selection on
      an internal part, dims it when the tree loses focus, and derives the colour from the
      accent ramp — none of which survives the "unmistakable selection" requirement.
    -->
    <ControlTheme x:Key="NotesTreeItemTheme" TargetType="TreeViewItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="Padding" Value="{DynamicResource PadTight}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Template">
        <ControlTemplate TargetType="TreeViewItem">
          <StackPanel>
            <Border Name="PART_Root"
                    Margin="0,1,0,0"
                    MinHeight="{TemplateBinding MinHeight}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <Grid Name="PART_Header" ColumnDefinitions="2,16,*">
                <Border Name="PART_SelectionBar"
                        Grid.Column="0"
                        Margin="0,1"
                        Background="Transparent" />

                <ToggleButton Name="PART_ExpandCollapseChevron"
                              Grid.Column="1"
                              Theme="{StaticResource NotesTreeChevronTheme}"
                              IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />

                <ContentPresenter Name="PART_HeaderPresenter"
                                  Grid.Column="2"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Center" />
              </Grid>
            </Border>

            <!-- Nesting the indent here makes it cumulative, so no level converter is needed. -->
            <ItemsPresenter Name="PART_ItemsPresenter"
                            Margin="12,0,0,0"
                            IsVisible="{TemplateBinding IsExpanded}"
                            ItemsPanel="{TemplateBinding ItemsPanel}" />
          </StackPanel>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
        <Setter Property="IsVisible" Value="False" />
      </Style>

      <Style Selector="^:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource AccentSubtle}" />
      </Style>

      <!-- Declared after :pointerover so the selected fill wins while hovered. Deliberately
           not keyed off focus: the selection has to stay readable while the transcript,
           the search box or another pane holds focus. -->
      <Style Selector="^:selected /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource AccentMuted}" />
      </Style>

      <Style Selector="^:selected /template/ Border#PART_SelectionBar">
        <Setter Property="Background" Value="{DynamicResource AccentBase}" />
      </Style>

      <Style Selector="^:selected:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource AccentMutedHover}" />
      </Style>
    </ControlTheme>

  </UserControl.Resources>

  <Border Background="{DynamicResource SurfaceSunken}"
          BorderBrush="{DynamicResource BorderDefault}"
          BorderThickness="0,0,1,0">
    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <ctl:PaneHeader Grid.Row="0" Header="NOTES">
        <StackPanel Classes="actions">
          <Button Classes="ghost" Content="Folder"
                  Command="{Binding OpenRootFolderCommand}"
                  ToolTip.Tip="Reveal the notes root in Explorer" />
          <Button Classes="ghost" Content="Reload" Command="{Binding RefreshCommand}" />
        </StackPanel>
      </ctl:PaneHeader>

      <TextBox Grid.Row="1"
               Classes="panesearch"
               PlaceholderText="Search titles and text…"
               Text="{Binding SearchText}" />

      <TreeView Grid.Row="2"
                Margin="4,0,10,0"
                Background="Transparent"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ItemsSource="{Binding Nodes}"
                SelectedItem="{Binding SelectedNode}">
        <TreeView.Styles>
          <Style Selector="TreeViewItem" x:DataType="vm:NotesTreeNodeViewModel">
            <Setter Property="Theme" Value="{StaticResource NotesTreeItemTheme}" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
          </Style>

          <!-- Project and date rows are signposts; the meeting leaves are the content. -->
          <Style Selector="TextBlock.grouphdr">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
            <Setter Property="LetterSpacing" Value="0.9" />
          </Style>

        </TreeView.Styles>
        <!-- Rows are Border.rowitem, the app-wide selection idiom, so the whole row comes up to
             full contrast when picked and the row action appears. Its chrome half is switched off
             per row (a local value outranks a style setter): the theme above already paints the
             fill and the 2px bar, across the chevron column too, and a second set doubles both. -->
        <TreeView.DataTemplates>

          <TreeDataTemplate DataType="vm:ProjectNodeViewModel" x:DataType="vm:ProjectNodeViewModel"
                            ItemsSource="{Binding Children}">
            <Border Classes="rowitem"
                    Classes.selected="{Binding $parent[TreeViewItem].IsSelected}"
                    Background="Transparent"
                    Padding="0"
                    BorderThickness="0"
                    AutomationProperties.Name="{Binding Name}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space3}">
                <TextBlock Grid.Column="0"
                           Classes="grouphdr"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Text="{Binding Name, Converter={StaticResource UpperCase}}" />
                <TextBlock Grid.Column="1" Classes="grouphdr" Text="{Binding CountText}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </TreeDataTemplate>

          <TreeDataTemplate DataType="vm:DateNodeViewModel" x:DataType="vm:DateNodeViewModel"
                            ItemsSource="{Binding Children}">
            <Border Classes="rowitem"
                    Classes.selected="{Binding $parent[TreeViewItem].IsSelected}"
                    Background="Transparent"
                    Padding="0"
                    BorderThickness="0"
                    AutomationProperties.Name="{Binding Label}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space3}">
                <TextBlock Grid.Column="0"
                           Classes="grouphdr"
                           VerticalAlignment="Center"
                           Text="{Binding Label, Converter={StaticResource UpperCase}}" />
                <TextBlock Grid.Column="1" Classes="grouphdr" Text="{Binding CountText}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </TreeDataTemplate>

          <DataTemplate DataType="vm:SessionNodeViewModel" x:DataType="vm:SessionNodeViewModel">
            <Border Classes="rowitem"
                    Classes.selected="{Binding $parent[TreeViewItem].IsSelected}"
                    Background="Transparent"
                    Padding="0"
                    BorderThickness="0"
                    AutomationProperties.Name="{Binding Title}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space2}">
                <StackPanel Grid.Column="0" Spacing="{DynamicResource Space1}">
                  <TextBlock Text="{Binding Title}" />
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space3}">
                    <TextBlock Classes="mono caption" Text="{Binding TimeText}" />
                    <TextBlock Classes="caption" Text="{Binding DurationText}" />
                    <TextBlock Classes="caption" Text="{Binding EntryCountText}" />
                    <Border Classes="badge" IsVisible="{Binding IsFromVideo}">
                      <TextBlock Text="VIDEO" />
                    </Border>
                  </StackPanel>
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="ghost rowaction"
                        VerticalAlignment="Center"
                        Content="Open"
                        Command="{Binding OpenFolderCommand}"
                        ToolTip.Tip="Reveal this session's folder in Explorer" />
              </Grid>
            </Border>
          </DataTemplate>

        </TreeView.DataTemplates>
      </TreeView>

      <ctl:PaneFooter Grid.Row="3" Summary="{Binding SummaryText}">
        <ctl:PaneFooter.Actions>
          <TextBlock Classes="caption" Text="loading…" IsVisible="{Binding IsBusy}" />
        </ctl:PaneFooter.Actions>
      </ctl:PaneFooter>
    </Grid>
  </Border>
</UserControl>
