<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    ============================================================================
    THE ICON SET — one source for every glyph in the app.

    All seven are authored on the SAME 16x16 grid and are stroked, not filled:
    open paths, round caps, round joins, no fill. Icon fits the whole 16x16 box
    into its own Size box, so relative weight is preserved between glyphs — that
    only holds while every glyph shares the grid, so keep new ones on it.

    IconMic / IconDocument / IconSliders are the nav rail's own three geometries,
    rescaled from the 18-unit box they were drawn in (x2/3 of a 24 grid is the
    same arithmetic). Adopting them rather than redrawing them means the rail
    looks identical the day it switches over.

    Consume with DynamicResource:
        <ctl:Icon Data="{DynamicResource IconRefresh}" />
    ============================================================================
  -->
  <Styles.Resources>

    <!-- Reload / re-scan. THE refresh glyph — the app previously had two, U+21BB
         in the capture bar and U+27F3 in the revision header, for one action. -->
    <StreamGeometry x:Key="IconRefresh">M 15.33,2.67 L 15.33,6.67 L 11.33,6.67 M 13.66,10 A 6,6 0 1 1 12.25,3.76 L 15.33,6.67</StreamGeometry>

    <!-- Fetch to disk. -->
    <StreamGeometry x:Key="IconDownload">M 2,10 L 2,13.5 L 14,13.5 L 14,10 M 4.5,7 L 8,10.5 L 11.5,7 M 8,10.5 L 8,2</StreamGeometry>

    <!-- Dismiss / cancel / close. Three of the eight text glyphs were this one. -->
    <StreamGeometry x:Key="IconClose">M 12,4 L 4,12 M 4,4 L 12,12</StreamGeometry>

    <!-- Settings. -->
    <StreamGeometry x:Key="IconSettings">M 8,5.6 A 2.4,2.4 0 1 0 8,10.4 A 2.4,2.4 0 1 0 8,5.6 M 8,1.6 L 8,3.2 M 8,12.8 L 8,14.4 M 1.6,8 L 3.2,8 M 12.8,8 L 14.4,8 M 3.47,3.47 L 4.82,4.82 M 11.18,11.18 L 12.53,12.53 M 12.53,3.47 L 11.18,4.82 M 4.82,11.18 L 3.47,12.53</StreamGeometry>

    <!-- Meeting / capture. -->
    <StreamGeometry x:Key="IconMic">M 6.22,4.44 A 1.78,1.78 0 0 1 9.78,4.44 L 9.78,8 A 1.78,1.78 0 0 1 6.22,8 Z M 4,8 A 4,4 0 0 0 12,8 M 8,12 L 8,13.78 M 5.78,13.78 L 10.22,13.78</StreamGeometry>

    <!-- Notes. -->
    <StreamGeometry x:Key="IconDocument">M 4,2.22 L 9.33,2.22 L 12,4.89 L 12,13.78 L 4,13.78 Z M 9.33,2.22 L 9.33,4.89 L 12,4.89 M 5.78,8 L 10.22,8 M 5.78,10.22 L 10.22,10.22 M 5.78,12 L 8.44,12</StreamGeometry>

    <!-- Inputs / routing. -->
    <StreamGeometry x:Key="IconSliders">M 2.67,4.44 L 6.22,4.44 M 9.78,4.44 L 13.33,4.44 M 8,2.67 L 8,6.22 M 2.67,8.89 L 8.89,8.89 M 12.44,8.89 L 13.33,8.89 M 10.67,7.11 L 10.67,10.67 M 2.67,13.33 L 4.44,13.33 M 8,13.33 L 13.33,13.33 M 6.22,11.56 L 6.22,15.11</StreamGeometry>

  </Styles.Resources>
</Styles>
