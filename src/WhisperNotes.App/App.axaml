<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WhisperNotes.App.App"
             RequestedThemeVariant="Dark">

  <!--
    ============================================================================
    WhisperNotes design system — implements design-tokens.md (v1).

    Dark-only, dense, VS Code / Linear flavoured. Every key in the contract is
    defined here; the legacy `Brush*` keys are kept alive as aliases that point
    at the new palette so the whole app shifts look in one move.

    Rules for views:
      * never hardcode a hex, a raw font size, or a magic margin
      * consume tokens with {DynamicResource Key} (or {StaticResource Key})
      * never re-skin a control locally — use the style classes below
    ============================================================================
  -->

  <Application.Resources>

    <!-- ======================================================================
         TYPOGRAPHY
         ====================================================================== -->
    <FontFamily x:Key="FontFamilyUi">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
    <FontFamily x:Key="FontFamilyMono">Cascadia Code,JetBrains Mono,Cascadia Mono,Consolas,Menlo,monospace</FontFamily>

    <!-- Legacy aliases (pre-contract names, still referenced by older markup). -->
    <FontFamily x:Key="UiFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Code,JetBrains Mono,Cascadia Mono,Consolas,Menlo,monospace</FontFamily>

    <x:Double x:Key="FontSizeXxs">10</x:Double>
    <x:Double x:Key="FontSizeXs">11</x:Double>
    <x:Double x:Key="FontSizeSm">12</x:Double>
    <x:Double x:Key="FontSizeMd">13</x:Double>
    <x:Double x:Key="FontSizeLg">15</x:Double>
    <x:Double x:Key="FontSizeXl">18</x:Double>
    <x:Double x:Key="FontSizeDisplay">22</x:Double>

    <!-- ======================================================================
         SPACING + RADII — base unit 4, deliberately tight

         The scale is 2/4/8/12/16/24 and nothing else. Anything a view needs that
         is not one of those six numbers is a composed thickness and belongs in
         the Pad* block below under a name, not inline as a magic margin.
         ====================================================================== -->
    <x:Double x:Key="Space1">2</x:Double>
    <x:Double x:Key="Space2">4</x:Double>
    <x:Double x:Key="Space3">8</x:Double>
    <x:Double x:Key="Space4">12</x:Double>
    <x:Double x:Key="Space5">16</x:Double>
    <x:Double x:Key="Space6">24</x:Double>

    <Thickness x:Key="PadMicro">2</Thickness>
    <Thickness x:Key="PadIcon">4</Thickness>
    <Thickness x:Key="PadTight">6,4</Thickness>
    <!-- Badge chrome. Was 5,1 — neither number is on the scale, and the 1px band made the
         badge's box a pixel shallower than the 13px text it sits beside. -->
    <Thickness x:Key="PadBadge">6,2</Thickness>
    <Thickness x:Key="PadControl">10,6</Thickness>
    <Thickness x:Key="PadCard">12,10</Thickness>
    <Thickness x:Key="PadPane">16,12</Thickness>
    <!-- The transport hero button. Was 16,9; 9 is off-scale and invisible anyway, because
         ControlHeightLg clamps the button taller than its own content. -->
    <Thickness x:Key="PadHero">16,8</Thickness>

    <!-- Pane furniture. Six sites across two views wrote these as 12,12,10,8 / 12,0,10,8 —
         the same arbitrary asymmetry copied verbatim. Squared off so the right gutter matches
         the left one. -->
    <Thickness x:Key="PadPaneHeader">12,12,12,8</Thickness>
    <Thickness x:Key="PadPaneField">12,0,12,8</Thickness>

    <CornerRadius x:Key="RadiusNone">0</CornerRadius>
    <CornerRadius x:Key="RadiusSm">3</CornerRadius>
    <CornerRadius x:Key="RadiusMd">5</CornerRadius>
    <CornerRadius x:Key="RadiusLg">8</CornerRadius>

    <!-- ======================================================================
         CONTROL HEIGHTS

         There was no such scale, so MinHeight was asserted as a literal in nine
         places with five different values (38/28/26/24/22/20) and three of those
         places were the same control stated twice. Four steps, each with a job:

           Xs  inline affordance inside a caption row (status bar path button)
           Sm  list, tree and menu rows; ghost buttons
           Md  the standard interactive control — button, text box, combo box,
               icon button. Everything that shares a toolbar row is this.
           Lg  the record hero, and nothing else

         Audit T6 wants Md retuned 28 -> 30 and Lg folded into Md so the capture
         bar reads as one strip. That is now a one-line change here rather than
         an eight-site edit, and it is the toolbar wave's call to make.
         ====================================================================== -->
    <x:Double x:Key="ControlHeightXs">20</x:Double>
    <x:Double x:Key="ControlHeightSm">24</x:Double>
    <x:Double x:Key="ControlHeightMd">28</x:Double>
    <x:Double x:Key="ControlHeightLg">38</x:Double>

    <!-- ======================================================================
         COMPONENT GEOMETRY
         Shared by Views/Controls/*. Named here so a component and the view that
         hosts it cannot disagree about a number.
         ====================================================================== -->
    <x:Double x:Key="DotSize">6</x:Double>
    <x:Double x:Key="DotSizeLg">8</x:Double>
    <x:Double x:Key="IconSize">16</x:Double>
    <!-- The grid every glyph in Views/Controls/Icons.axaml is drawn on. Changing this without
         redrawing all seven glyphs shifts every icon off centre; change IconSize instead. -->
    <x:Double x:Key="IconGrid">16</x:Double>
    <x:Double x:Key="IconStrokeThickness">1.3</x:Double>
    <x:Double x:Key="SeparatorThickness">1</x:Double>
    <x:Double x:Key="SeparatorLength">20</x:Double>
    <x:Double x:Key="ProgressBarThickness">4</x:Double>
    <x:Double x:Key="ProgressBarWidth">88</x:Double>
    <x:Double x:Key="EmptyStateMaxWidth">380</x:Double>
    <x:Double x:Key="ToastMinWidth">288</x:Double>
    <x:Double x:Key="SeverityBarWidth">3</x:Double>

    <!-- The selection idiom's left bar, as a width and as the border thickness that draws it. -->
    <x:Double x:Key="SelectionBarWidth">2</x:Double>
    <Thickness x:Key="SelectionBarThickness">2,0,0,0</Thickness>

    <!-- ======================================================================
         SURFACES — darkest to lightest, layered elevation
         ====================================================================== -->
    <SolidColorBrush x:Key="SurfaceSunken" Color="#0F1115" />
    <SolidColorBrush x:Key="SurfaceBase" Color="#15181E" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="#1B1F27" />
    <SolidColorBrush x:Key="SurfaceOverlay" Color="#232833" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#252B36" />
    <SolidColorBrush x:Key="SurfacePressed" Color="#2D3441" />

    <!-- ======================================================================
         BORDERS
         ====================================================================== -->
    <SolidColorBrush x:Key="BorderSubtle" Color="#232833" />
    <SolidColorBrush x:Key="BorderDefault" Color="#2E3542" />
    <SolidColorBrush x:Key="BorderStrong" Color="#3D4655" />

    <!-- ======================================================================
         TEXT
         ====================================================================== -->
    <SolidColorBrush x:Key="TextPrimary" Color="#E6E9EF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A2ABBC" />
    <SolidColorBrush x:Key="TextMuted" Color="#6B7688" />
    <SolidColorBrush x:Key="TextInverse" Color="#0F1115" />

    <!-- ======================================================================
         ACCENT + STATUS
         ====================================================================== -->
    <SolidColorBrush x:Key="AccentBase" Color="#4C8DFF" />
    <SolidColorBrush x:Key="AccentHover" Color="#639CFF" />
    <SolidColorBrush x:Key="AccentPressed" Color="#3A79E6" />
    <SolidColorBrush x:Key="AccentMuted" Color="#1E3355" />
    <SolidColorBrush x:Key="AccentSubtle" Color="#182740" />
    <SolidColorBrush x:Key="SuccessBase" Color="#3FB950" />
    <SolidColorBrush x:Key="WarningBase" Color="#D29922" />
    <SolidColorBrush x:Key="DangerBase" Color="#F05D5D" />
    <SolidColorBrush x:Key="InfoBase" Color="#4C8DFF" />

    <!-- Additive (not in the contract, but needed for hover/fill pairs). -->
    <SolidColorBrush x:Key="AccentMutedHover" Color="#26406B" />
    <SolidColorBrush x:Key="SuccessMuted" Color="#13301C" />
    <SolidColorBrush x:Key="WarningMuted" Color="#2E2411" />
    <SolidColorBrush x:Key="DangerMuted" Color="#3A1518" />
    <SolidColorBrush x:Key="InfoMuted" Color="#1E3355" />

    <!-- The danger ramp's hover/press pair, to sit beside AccentHover/AccentPressed. These two
         were written as raw hex four times: twice for Button.danger and twice more for
         Button.record.rolling, which restated them verbatim. One definition, both consumers. -->
    <SolidColorBrush x:Key="DangerHover" Color="#FF7B7B" />
    <SolidColorBrush x:Key="DangerPressed" Color="#D24C4C" />

    <!-- Modal scrim. Alpha-over-SurfaceSunken; a view had this inline as #B00F1115. -->
    <SolidColorBrush x:Key="ScrimOverlay" Color="#B00F1115" />

    <!-- ======================================================================
         AI-SPECIFIC
         ====================================================================== -->
    <SolidColorBrush x:Key="AiAccent" Color="#B57CFF" />
    <SolidColorBrush x:Key="AiAccentHover" Color="#C99AFF" />
    <SolidColorBrush x:Key="AiAccentBright" Color="#D5B6FF" />
    <SolidColorBrush x:Key="AiAccentMuted" Color="#2A1F3D" />
    <SolidColorBrush x:Key="AiAccentMutedHover" Color="#392A52" />
    <SolidColorBrush x:Key="DiffAddBg" Color="#11301C" />
    <SolidColorBrush x:Key="DiffAddFg" Color="#7EE787" />
    <SolidColorBrush x:Key="DiffRemoveBg" Color="#3A1518" />
    <SolidColorBrush x:Key="DiffRemoveFg" Color="#FF9492" />

    <!-- ======================================================================
         EDITOR SURFACE (AvaloniaEdit / TextMate chrome)
         ====================================================================== -->
    <SolidColorBrush x:Key="EditorBackground" Color="#12151B" />
    <SolidColorBrush x:Key="EditorGutterBackground" Color="#12151B" />
    <SolidColorBrush x:Key="EditorLineNumber" Color="#4A5364" />
    <SolidColorBrush x:Key="EditorCurrentLine" Color="#191D25" />
    <SolidColorBrush x:Key="EditorSelection" Color="#2A4A7A" />
    <SolidColorBrush x:Key="EditorCaret" Color="#E6E9EF" />

    <!-- ======================================================================
         LEGACY ALIASES
         Pre-contract keys, re-pointed at the new palette. Do not delete: other
         views still bind to these names.
         ====================================================================== -->
    <SolidColorBrush x:Key="BrushWindow" Color="#0F1115" />       <!-- SurfaceSunken -->
    <SolidColorBrush x:Key="BrushPanel" Color="#15181E" />        <!-- SurfaceBase -->
    <SolidColorBrush x:Key="BrushSidebar" Color="#0F1115" />      <!-- SurfaceSunken -->
    <SolidColorBrush x:Key="BrushSurface" Color="#1B1F27" />      <!-- SurfaceRaised -->
    <SolidColorBrush x:Key="BrushLine" Color="#2E3542" />         <!-- BorderDefault -->
    <SolidColorBrush x:Key="BrushLineSoft" Color="#232833" />     <!-- BorderSubtle -->
    <SolidColorBrush x:Key="BrushText" Color="#E6E9EF" />         <!-- TextPrimary -->
    <SolidColorBrush x:Key="BrushMuted" Color="#A2ABBC" />        <!-- TextSecondary -->
    <SolidColorBrush x:Key="BrushFaint" Color="#6B7688" />        <!-- TextMuted -->
    <SolidColorBrush x:Key="BrushAccent" Color="#4C8DFF" />       <!-- AccentBase -->
    <SolidColorBrush x:Key="BrushAccentSoft" Color="#1E3355" />   <!-- AccentMuted -->
    <SolidColorBrush x:Key="BrushRec" Color="#F05D5D" />          <!-- DangerBase -->
    <SolidColorBrush x:Key="BrushRecSoft" Color="#3A1518" />      <!-- DangerMuted -->
    <SolidColorBrush x:Key="BrushGood" Color="#3FB950" />         <!-- SuccessBase -->
    <SolidColorBrush x:Key="BrushWarn" Color="#D29922" />         <!-- WarningBase -->
    <SolidColorBrush x:Key="BrushMeterLow" Color="#3FB950" />     <!-- SuccessBase -->
    <SolidColorBrush x:Key="BrushMeterMid" Color="#D29922" />     <!-- WarningBase -->
    <SolidColorBrush x:Key="BrushMeterHigh" Color="#F05D5D" />    <!-- DangerBase -->
    <SolidColorBrush x:Key="BrushMarkerBg" Color="#2E2411" />     <!-- WarningMuted -->
    <SolidColorBrush x:Key="BrushMarkerEdge" Color="#D29922" />   <!-- WarningBase -->
    <SolidColorBrush x:Key="BrushActionBg" Color="#102A31" />     <!-- action-item teal, muted -->
    <SolidColorBrush x:Key="BrushActionEdge" Color="#3FC8D8" />   <!-- action-item teal -->
    <SolidColorBrush x:Key="BrushManualEdge" Color="#8390F2" />   <!-- human-authored marker -->

    <!-- ======================================================================
         FLUENT SYSTEM ACCENT RAMP
         Fluent derives every built-in selection/focus visual from these, so they
         are retuned to the AccentBase (#4C8DFF) family.
         ====================================================================== -->
    <Color x:Key="SystemAccentColor">#4C8DFF</Color>
    <Color x:Key="SystemAccentColorDark1">#3F76D6</Color>
    <Color x:Key="SystemAccentColorDark2">#3260AD</Color>
    <Color x:Key="SystemAccentColorDark3">#264985</Color>
    <Color x:Key="SystemAccentColorLight1">#6FA4FF</Color>
    <Color x:Key="SystemAccentColorLight2">#93BAFF</Color>
    <Color x:Key="SystemAccentColorLight3">#B7D1FF</Color>

    <!-- ======================================================================
         FLUENT THEME-RESOURCE OVERRIDES
         Application.Resources is consulted before the theme's own dictionaries,
         so these retarget Fluent internals that are awkward to reach by selector.
         ====================================================================== -->
    <CornerRadius x:Key="ControlCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">5</CornerRadius>

    <!--
      A Fluent theme key IS the resource, so its value has to be a literal — it cannot be
      {StaticResource ControlHeightMd}. Each one therefore carries the token it tracks in a
      comment; change the token above and these follow by hand. They are the only literals in
      this file that are allowed to restate a token.
    -->
    <x:Double x:Key="ScrollBarSize">8</x:Double>                    <!-- = Space3 -->
    <x:Double x:Key="TextControlThemeMinHeight">28</x:Double>       <!-- = ControlHeightMd -->
    <x:Double x:Key="ComboBoxMinHeight">28</x:Double>               <!-- = ControlHeightMd -->
    <x:Double x:Key="TreeViewItemMinHeight">24</x:Double>           <!-- = ControlHeightSm -->
    <x:Double x:Key="ToolTipContentThemeFontSize">12</x:Double>     <!-- = FontSizeSm -->

    <Thickness x:Key="ListBoxItemPadding">8,4</Thickness>           <!-- = Space3,Space2 -->
    <Thickness x:Key="ComboBoxItemThemePadding">10,6</Thickness>    <!-- = PadControl -->
    <Thickness x:Key="MenuFlyoutItemThemePadding">10,6</Thickness>  <!-- = PadControl -->
    <Thickness x:Key="TextControlThemePadding">10,6</Thickness>     <!-- = PadControl -->
    <Thickness x:Key="ComboBoxPadding">10,6</Thickness>             <!-- = PadControl -->

    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#6B7688" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#6B7688" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#6B7688" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#4A5364" />

    <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#6B7688" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#232833" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#2E3542" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#A2ABBC" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="#E6E9EF" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#252B36" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#1E3355" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#26406B" />
    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#E6E9EF" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#E6E9EF" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#E6E9EF" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#E6E9EF" />

    <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#182740" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#1E3355" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#26406B" />
    <SolidColorBrush x:Key="TreeViewItemForeground" Color="#E6E9EF" />
    <SolidColorBrush x:Key="TreeViewItemForegroundPointerOver" Color="#E6E9EF" />
    <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="#E6E9EF" />
    <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver" Color="#E6E9EF" />

    <SolidColorBrush x:Key="ToolTipBackground" Color="#232833" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#2E3542" />
    <SolidColorBrush x:Key="ToolTipForeground" Color="#E6E9EF" />

    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#232833" />
    <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#2E3542" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#232833" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#2E3542" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#252B36" />
    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#E6E9EF" />
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#E6E9EF" />

    <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#6B7688" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#6B7688" />
    <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="Transparent" />

  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

    <!-- ======================================================================
         1. IMPLICIT DEFAULTS
         ====================================================================== -->
    <Style Selector=":is(Window)">
      <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
    </Style>

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="ContentControl">
      <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
    </Style>

    <!-- ======================================================================
         2. TEXTBLOCK CLASSES
         ====================================================================== -->
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="{StaticResource FontSizeXl}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="{StaticResource FontSizeLg}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>

    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>

    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>

    <!-- Legacy text classes. -->
    <Style Selector="TextBlock.section">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeXxs}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.1" />
      <Setter Property="TextTrimming" Value="None" />
    </Style>

    <Style Selector="TextBlock.faint">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
    </Style>

    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="{StaticResource FontSizeXl}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ======================================================================
         3. BORDER CLASSES
         ====================================================================== -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Padding" Value="{StaticResource PadCard}" />
    </Style>

    <Style Selector="Border.pane">
      <Setter Property="Background" Value="{StaticResource SurfaceBase}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
      <Setter Property="Padding" Value="{StaticResource PadPane}" />
    </Style>

    <Style Selector="Border.toolbar">
      <Setter Property="Background" Value="{StaticResource SurfaceBase}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="{StaticResource PadControl}" />
    </Style>

    <Style Selector="Border.divider">
      <Setter Property="Background" Value="{StaticResource BorderSubtle}" />
      <Setter Property="Height" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- ======================================================================
         4. BUTTONS
         ====================================================================== -->
    <Style Selector="Button">
      <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Padding" Value="{StaticResource PadControl}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
      <Setter Property="MinHeight" Value="{StaticResource ControlHeightMd}" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfacePressed}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceBase}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextMuted}" />
    </Style>

    <Style Selector="Button:disabled">
      <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <Style Selector="Button:disabled TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>

    <!-- accent -->
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{StaticResource AccentBase}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBase}" />
      <Setter Property="Foreground" Value="{StaticResource TextInverse}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextInverse}" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentHover}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentHover}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextInverse}" />
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentPressed}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentPressed}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextInverse}" />
    </Style>

    <!-- danger -->
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{StaticResource DangerBase}" />
      <Setter Property="BorderBrush" Value="{StaticResource DangerBase}" />
      <Setter Property="Foreground" Value="{StaticResource TextInverse}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.danger TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextInverse}" />
    </Style>
    <!--
      .danger's hover and press states are declared once, jointly with .record.rolling, further
      down — see "the danger ramp" after the record button. They have to sit after
      Button.record:pointerover or the record button's blue hover wins while rolling, and there
      is no reason for one ramp to be written out twice.
    -->

    <!-- subtle -->
    <Style Selector="Button.subtle">
      <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>
    <Style Selector="Button.subtle TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>
    <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="Button.subtle:pointerover TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- ghost -->
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="Padding" Value="{StaticResource PadTight}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
      <Setter Property="MinHeight" Value="{StaticResource ControlHeightSm}" />
    </Style>
    <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    </Style>
    <Style Selector="Button.ghost TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="Button.ghost:pointerover TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfacePressed}" />
    </Style>

    <!--
      pill — a fully rounded modifier for buttons that float over content rather than sitting in
      a row. The radius has to be restated on the presenter because the base and ghost styles
      pin it there; setting CornerRadius on the Button alone is silently ignored.
    -->
    <Style Selector="Button.pill">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    </Style>
    <Style Selector="Button.pill /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    </Style>

    <!--
      icon — square, and the same height as everything else on a toolbar row. It used to be 26
      against the 28 of the buttons, text boxes and combo boxes beside it, which is one of the
      four different pairs of horizontal edges the eye had to track across the capture bar.
    -->
    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="Padding" Value="{StaticResource PadIcon}" />
      <Setter Property="MinWidth" Value="{StaticResource ControlHeightMd}" />
      <Setter Property="MinHeight" Value="{StaticResource ControlHeightMd}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
    </Style>
    <Style Selector="Button.icon /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    </Style>
    <Style Selector="Button.icon TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="Button.icon:pointerover TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfacePressed}" />
    </Style>

    <!-- ai -->
    <Style Selector="Button.ai">
      <Setter Property="Background" Value="{StaticResource AiAccentMuted}" />
      <Setter Property="BorderBrush" Value="{StaticResource AiAccent}" />
      <Setter Property="Foreground" Value="{StaticResource AiAccent}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.ai TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AiAccent}" />
    </Style>
    <Style Selector="Button.ai:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AiAccentMutedHover}" />
      <Setter Property="BorderBrush" Value="{StaticResource AiAccentHover}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource AiAccentBright}" />
    </Style>
    <Style Selector="Button.ai:pointerover TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AiAccentBright}" />
    </Style>
    <Style Selector="Button.ai:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AiAccentMuted}" />
    </Style>

    <!-- record (transport hero button) -->
    <Style Selector="Button.record">
      <Setter Property="Background" Value="{StaticResource AccentBase}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBase}" />
      <Setter Property="Foreground" Value="{StaticResource TextInverse}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeLg}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Padding" Value="{StaticResource PadHero}" />
      <Setter Property="MinHeight" Value="{StaticResource ControlHeightLg}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.record TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextInverse}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeLg}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.3" />
      <Setter Property="TextTrimming" Value="None" />
    </Style>
    <Style Selector="Button.record:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentHover}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentHover}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextInverse}" />
    </Style>
    <Style Selector="Button.record:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentPressed}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentPressed}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextInverse}" />
    </Style>

    <Style Selector="Button.record.rolling">
      <Setter Property="Background" Value="{StaticResource DangerBase}" />
      <Setter Property="BorderBrush" Value="{StaticResource DangerBase}" />
      <Setter Property="Foreground" Value="{StaticResource TextInverse}" />
    </Style>

    <!--
      The danger ramp — one definition, two consumers. A destructive button and a rolling record
      button are the same promise ("this ends something"), so they hover and press identically.
      Declared here, after Button.record's own blue hover, because a later match wins.
    -->
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.record.rolling:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource DangerHover}" />
      <Setter Property="BorderBrush" Value="{StaticResource DangerHover}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextInverse}" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     Button.record.rolling:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource DangerPressed}" />
      <Setter Property="BorderBrush" Value="{StaticResource DangerPressed}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextInverse}" />
    </Style>

    <!-- ======================================================================
         5. FOCUS-VISIBLE RING — 1px AccentBase outline
         ====================================================================== -->
    <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBase}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ======================================================================
         6. TEXTBOX
         Fluent draws the fill/outline on PART_BorderElement, so the states must
         target the part or the theme's own setters win.
         ====================================================================== -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBase}" />
      <Setter Property="SelectionBrush" Value="{StaticResource AccentMuted}" />
      <Setter Property="SelectionForegroundBrush" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Padding" Value="{StaticResource PadControl}" />
      <Setter Property="MinHeight" Value="{StaticResource ControlHeightMd}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
    </Style>

    <Style Selector="TextBox /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="MinHeight" Value="{StaticResource ControlHeightMd}" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBase}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox:focus-within /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBase}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox:focus-visible /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBase}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource SurfaceBase}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox:disabled">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>

    <Style Selector="TextBox /template/ TextBlock#PART_Placeholder">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
    </Style>

    <Style Selector="TextBox /template/ TextBlock#PART_FloatingPlaceholder">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>

    <!-- ======================================================================
         7. COMBOBOX
         ====================================================================== -->
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Padding" Value="{StaticResource PadControl}" />
      <Setter Property="MinHeight" Value="{StaticResource ControlHeightMd}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
    </Style>

    <Style Selector="ComboBox /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    </Style>

    <Style Selector="ComboBox:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
    </Style>

    <Style Selector="ComboBox:pressed /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource SurfacePressed}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
    </Style>

    <Style Selector="ComboBox:focus /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBase}" />
    </Style>

    <Style Selector="ComboBox:focus-visible /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBase}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="ComboBox:disabled /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource SurfaceBase}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
    </Style>

    <!-- Fluent paints a second border on top for the focus highlight. -->
    <Style Selector="ComboBox /template/ Border#HighlightBackground">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBase}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    </Style>

    <Style Selector="ComboBox /template/ TextBlock#PlaceholderTextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
    </Style>

    <!-- Dropdown surface -->
    <Style Selector="ComboBox /template/ Border#PopupBorder">
      <Setter Property="Background" Value="{StaticResource SurfaceOverlay}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    </Style>

    <Style Selector="ComboBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="Padding" Value="{StaticResource PadControl}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <!-- A dropdown row is a list row: same height as TreeViewItem and MenuItem, not its own. -->
      <Setter Property="MinHeight" Value="{StaticResource ControlHeightSm}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
    </Style>

    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentMuted}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentMutedHover}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- ======================================================================
         8. LISTBOXITEM — high-contrast selection
         ====================================================================== -->
    <!--
      Density (padding) is deliberately left to the ListBoxItemPadding theme resource rather than
      set here: a view that supplies its own ItemContainerTheme — the transcript log does — must
      still be able to zero it out. Avalonia gives Styles a higher priority than ControlThemes, so
      anything set in this Style is unavoidable for such a view.
    -->
    <Style Selector="ListBoxItem">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    </Style>

    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSubtle}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentMuted}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentMutedHover}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="{StaticResource AccentMuted}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- Fluent 12 draws a selection pipe; keep it on-palette. -->
    <Style Selector="ListBoxItem /template/ Rectangle#PART_SelectedPipe">
      <Setter Property="Fill" Value="{StaticResource AccentBase}" />
    </Style>
    <Style Selector="ListBoxItem /template/ Border#PART_SelectedPipe">
      <Setter Property="Background" Value="{StaticResource AccentBase}" />
    </Style>

    <Style Selector="ListBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBase}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--
      Escape hatch for lists that are a log, not a picker: put Classes="plain" on the ListBox (or
      the item) and every scrap of selection/hover chrome above is switched back off.
    -->
    <Style Selector="ListBox.plain ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBoxItem.plain /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem.plain">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- ======================================================================
         9. TREEVIEWITEM — Fluent paints selection through the header presenter,
         so setting TreeViewItem.Background alone looks like nothing happened.
         ====================================================================== -->
    <Style Selector="TreeViewItem">
      <Setter Property="Padding" Value="{StaticResource PadTight}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="MinHeight" Value="{StaticResource ControlHeightSm}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
    </Style>

    <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="MinHeight" Value="{StaticResource ControlHeightSm}" />
    </Style>

    <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{StaticResource AccentSubtle}" />
    </Style>
    <Style Selector="TreeViewItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSubtle}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="TreeViewItem:selected">
      <Setter Property="Background" Value="{StaticResource AccentMuted}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{StaticResource AccentMuted}" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Background" Value="{StaticResource AccentMuted}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{StaticResource AccentMutedHover}" />
    </Style>
    <Style Selector="TreeViewItem:selected:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Background" Value="{StaticResource AccentMutedHover}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="TreeViewItem:focus-visible /template/ Border#PART_LayoutRoot">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBase}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ======================================================================
         10. SCROLLVIEWER / SCROLLBAR — thin 8px overlay bars, no arrows
         ====================================================================== -->
    <Style Selector="ScrollViewer">
      <Setter Property="AllowAutoHide" Value="True" />
    </Style>

    <Style Selector="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ScrollBar:vertical">
      <Setter Property="Width" Value="{StaticResource ScrollBarSize}" />
      <Setter Property="MinWidth" Value="{StaticResource ScrollBarSize}" />
    </Style>

    <Style Selector="ScrollBar:horizontal">
      <Setter Property="Height" Value="{StaticResource ScrollBarSize}" />
      <Setter Property="MinHeight" Value="{StaticResource ScrollBarSize}" />
    </Style>

    <Style Selector="ScrollBar /template/ Thumb">
      <Setter Property="Background" Value="{StaticResource BorderStrong}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ScrollBar:pointerover /template/ Thumb">
      <Setter Property="Background" Value="{StaticResource TextMuted}" />
    </Style>

    <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="ScrollBar /template/ RepeatButton#PART_LineDownButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="ScrollBar /template/ RepeatButton#PART_PageUpButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ScrollBar /template/ RepeatButton#PART_PageDownButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ======================================================================
         11. OVERLAY SURFACES — tooltip, flyouts, menus, popups
         ====================================================================== -->
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="{StaticResource SurfaceOverlay}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Padding" Value="{StaticResource PadTight}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
      <Setter Property="MaxWidth" Value="360" />
    </Style>

    <Style Selector="ToolTip TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="None" />
    </Style>

    <Style Selector="ContextMenu">
      <Setter Property="Background" Value="{StaticResource SurfaceOverlay}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Padding" Value="{StaticResource PadMicro}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
    </Style>

    <Style Selector="MenuFlyoutPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceOverlay}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Padding" Value="{StaticResource PadMicro}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
    </Style>

    <Style Selector="FlyoutPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceOverlay}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Padding" Value="{StaticResource PadCard}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
    </Style>

    <Style Selector="MenuItem">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="Padding" Value="{StaticResource PadControl}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="MinHeight" Value="{StaticResource ControlHeightSm}" />
    </Style>

    <Style Selector="MenuItem TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
    </Style>

    <!-- No heavier shadow than a hairline border, per the contract. -->
    <Style Selector="Popup">
      <Setter Property="WindowManagerAddShadowHint" Value="False" />
    </Style>

    <!-- ======================================================================
         12. PROGRESSBAR
         ====================================================================== -->
    <Style Selector="ProgressBar">
      <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
      <Setter Property="Foreground" Value="{StaticResource AccentBase}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="MinHeight" Value="{StaticResource ProgressBarThickness}" />
    </Style>

    <!--
      Fluent's ProgressBar theme carries MinWidth 200, and MinWidth beats Width in Avalonia's
      measure clamp — so setting Width on a progress bar did nothing unless the call site also
      restated MinWidth as a LOCAL value. One view had learned that and written it down in a
      comment; the other had not. Every bar in this app is given a width by whatever hosts it, so
      the floor is zero and Width means what it says.

      The `:horizontal` is load-bearing. Fluent declares its 200 under that pseudo-class, and a
      selector with an activator binds at StyleTrigger priority, which outranks both a plain Style
      and a TemplateBinding. An unqualified `ProgressBar` setter here loses to it silently.
    -->
    <Style Selector="ProgressBar:horizontal">
      <Setter Property="MinWidth" Value="0" />
    </Style>

    <Style Selector="ProgressBar:vertical">
      <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="ProgressBar /template/ Border#PART_Indicator">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    </Style>

    <!-- ======================================================================
         13. APP COMPONENTS — badges, transport, meter, note rows
         ====================================================================== -->

    <!--
      Kind / device badges. The default typography is the keyword look — bold, letter-spaced,
      the smallest size on the scale. A badge carrying a VALUE rather than a keyword (a speaker's
      name, say) turns that back down with Classes="badge soft"; see Views/Controls.
    -->
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Padding" Value="{StaticResource PadBadge}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
    </Style>

    <Style Selector="Border.badge > TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeXxs}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="0.8" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="TextTrimming" Value="None" />
    </Style>

    <Style Selector="Border.badge.loopback">
      <Setter Property="Background" Value="{StaticResource AccentMuted}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBase}" />
    </Style>

    <Style Selector="Border.badge.loopback > TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AccentBase}" />
    </Style>

    <Style Selector="Border.badge.marker">
      <Setter Property="Background" Value="{StaticResource BrushMarkerBg}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushMarkerEdge}" />
    </Style>

    <Style Selector="Border.badge.marker > TextBlock">
      <Setter Property="Foreground" Value="{StaticResource BrushMarkerEdge}" />
    </Style>

    <Style Selector="Border.badge.action">
      <Setter Property="Background" Value="{StaticResource BrushActionBg}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushActionEdge}" />
    </Style>

    <Style Selector="Border.badge.action > TextBlock">
      <Setter Property="Foreground" Value="{StaticResource BrushActionEdge}" />
    </Style>

    <!-- Recording indicator -->
    <Style Selector="Ellipse.pulse">
      <Style.Animations>
        <Animation Duration="0:0:1.3" IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Opacity" Value="0.2" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!--
      Transcript rows. Same bones as .rowitem below, but a log row is not a picker row: it
      hovers to SurfaceHover rather than the accent tint, and it carries provenance modifiers
      (.manual / .marker / .action) that mean nothing outside the transcript.

      These four belong in a transcript template, not in the app's vocabulary. They are still
      here because their two consumers — LiveNotesView's item template and the session leaf in
      NotesBrowserView — also own two code-behind handlers that cannot move into a shared
      ResourceDictionary. Move them the day those handlers become commands.
    -->
    <Style Selector="Border.row">
      <Setter Property="Padding" Value="{StaticResource PadControl}" />
      <Setter Property="BorderThickness" Value="{StaticResource SelectionBarThickness}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.row:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
    </Style>

    <Style Selector="Border.row.manual">
      <Setter Property="BorderBrush" Value="{StaticResource BrushManualEdge}" />
    </Style>

    <Style Selector="Border.row.marker">
      <Setter Property="Background" Value="{StaticResource BrushMarkerBg}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushMarkerEdge}" />
    </Style>

    <Style Selector="Border.row.action">
      <Setter Property="Background" Value="{StaticResource BrushActionBg}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushActionEdge}" />
    </Style>

    <!-- ======================================================================
         14. SELECTION — one idiom, one definition

         A 2px AccentBase left bar, an AccentMuted fill and TextPrimary text.
         The app already spoke this language in four places and disagreed with
         itself in all four:

           Border.row      here          Padding 10,6    no radius
           Border.noterow  NotesWorkspaceView:14-30      Padding 10,7   RadiusSm
           Border.revrow   NoteRevisionsView:40-56       Padding 12,10  RadiusSm
           Border.picked   NotesBrowserView:168-174      Padding PadTight, radius via TreeViewItem

         Three paddings and two radius decisions for one concept. This is that
         concept, settled: PadControl and RadiusSm.

           row:    <Border Classes="rowitem"
                           Classes.selected="{Binding $parent[ListBoxItem].IsSelected}" />
           button: <Button Classes="ghost" Classes.selected="{Binding IsHistoryPane}" />

         Style the row, do not wrap it. All four call sites drive selection from
         $parent[ListBoxItem].IsSelected or $parent[TreeViewItem].IsSelected, so
         the row must stay a Border inside the same container — an ancestor walk
         passes through a UserControl but not through a changed container type.
         ====================================================================== -->
    <Style Selector="Border.rowitem">
      <Setter Property="Padding" Value="{StaticResource PadControl}" />
      <Setter Property="BorderThickness" Value="{StaticResource SelectionBarThickness}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    </Style>

    <Style Selector="Border.rowitem:pointerover">
      <Setter Property="Background" Value="{StaticResource AccentSubtle}" />
    </Style>

    <Style Selector="Border.rowitem.selected">
      <Setter Property="Background" Value="{StaticResource AccentMuted}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBase}" />
    </Style>

    <Style Selector="Border.rowitem.selected:pointerover">
      <Setter Property="Background" Value="{StaticResource AccentMutedHover}" />
    </Style>

    <!-- The whole row comes up to full contrast, metadata included — not just its title. -->
    <Style Selector="Border.rowitem.selected TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <!--
      Row actions: transparent until the row is hovered or picked, never absent. Hiding one
      outright would reflow the row the moment the pointer crossed it.
    -->
    <Style Selector="Border.row Button.rowaction, Border.rowitem Button.rowaction">
      <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="Border.row:pointerover Button.rowaction,
                     Border.rowitem:pointerover Button.rowaction,
                     Border.rowitem.selected Button.rowaction">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!--
      The selected tab / mode / segment. Button.mode.on (NoteEditorView:22-29) and Button.tab.on
      (NotesWorkspaceView:33-40) were byte-for-byte identical apart from the class name; this is
      that pair written once, under the same word the rows use.

      MainWindow's nav rail already binds Classes.selected and paints itself a third way
      (foreground + a sibling bar). It keeps its own look: Window.Styles are applied after
      Application.Styles, so `Button.nav /template/ ContentPresenter` (MainWindow:89-93) wins on
      the presenter's Background. Re-check the rail if these two ever move sheets.
    -->
    <Style Selector="Button.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentMuted}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBase}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="Button.selected TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="Button.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentMutedHover}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBase}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- ======================================================================
         15. SHARED COMPONENTS
         Control themes and the class styles that go with them. Included last so
         a component's own rules can refine anything above. See
         Views/Controls/Controls.axaml.
         ====================================================================== -->
    <StyleInclude Source="/Views/Controls/Controls.axaml" />
  </Application.Styles>
</Application>
