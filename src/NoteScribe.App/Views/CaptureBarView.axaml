<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NoteScribe.App.ViewModels"
             xmlns:dd="using:NoteScribe.App.DesignData"
             mc:Ignorable="d"
             x:Class="NoteScribe.App.Views.CaptureBarView"
             x:DataType="vm:MainWindowViewModel"
             d:DataContext="{x:Static dd:DesignTime.Main}">

  <!--
    ==========================================================================================
    Capture bar — ONE row.

    It used to be a three-column block ~180px tall: a stack of section labels, a channel
    detail line, a model picker with a reserved progress strip, session/project inputs and a
    "NOT RECORDING" explainer card. That is a quarter of the window spent before the first
    transcript line, and most of it restated what the status bar already says.

    Everything StatusBarView already carries has been deleted rather than relocated:
      * the channel detail line ("LOOPBACK · native 44.1 kHz · stereo · resampled to 16 kHz")
        — StatusBarView column 1 renders it verbatim; it survives here only as the channel
        picker's tooltip, which is where you look when you are choosing a device
      * the model status ("base · on disk") — StatusBarView column 0, dot and all; the model
        picker's own item template repeats it per row anyway
      * the AUDIO CHANNEL / WHISPER MODEL / SESSION section headings — placeholders and the
        controls' own shapes say the same thing in a row that is read left to right
      * the "NOT RECORDING" card — pure prose, and the record button's own label and colour
        already state the transport's state

    HEIGHT IS PINNED, deliberately (CaptureBarRowHeight). This bar sizes the row above the
    transcript ScrollViewer; if it changes height at runtime, the viewport is resized under a
    stationary scroll offset and the transcript loses its place. A fixed row height makes that
    impossible by construction: no state change — recording, downloading, a silent channel, a
    long device name — can move it, because nothing in here is allowed to measure taller than
    the row. The reserved download strip below keeps that promise for the one control that
    genuinely appears and disappears.
    ==========================================================================================
  -->

  <UserControl.Resources>
    <!-- Bar geometry. Named rather than inline so no raw number appears in the markup. -->
    <x:Double x:Key="CaptureBarRowHeight">50</x:Double>

    <!-- Column geometry. ColumnDefinition.MinWidth is a plain double, so these can be tokens;
         the two star weights are GridLengths and are written inline below. -->
    <x:Double x:Key="ChannelMinWidth">200</x:Double>
    <x:Double x:Key="SessionMinWidth">160</x:Double>
    <x:Double x:Key="ModelComboWidth">150</x:Double>
    <x:Double x:Key="ProjectWidth">160</x:Double>

    <!-- The level readout is fixed-width so a changing dBFS number cannot shuffle the row. -->
    <x:Double x:Key="LevelTextWidth">72</x:Double>

    <!-- Reserved download strip: the box is permanent, only its contents toggle. Its WIDTH is
         pinned to the model combo + its button (150 + Space2 + a 26px icon button) so the
         download status text — which grows as the byte counter does — can never widen the
         column it sits under and shove the rest of the toolbar off the right edge. -->
    <x:Double x:Key="DownloadStripWidth">180</x:Double>
    <x:Double x:Key="DownloadStripHeight">14</x:Double>
    <x:Double x:Key="DownloadBarWidth">36</x:Double>
    <x:Double x:Key="DownloadBarHeight">4</x:Double>

    <x:Double x:Key="ModelDotSize">6</x:Double>
    <x:Double x:Key="RecordDotSize">9</x:Double>
  </UserControl.Resources>

  <Border Classes="toolbar">
    <Grid Height="{StaticResource CaptureBarRowHeight}" ColumnSpacing="{StaticResource Space3}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.6*" MinWidth="{StaticResource ChannelMinWidth}" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="{StaticResource SessionMinWidth}" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- ============ Audio channel: the control that decides whether the hour was wasted ============ -->
      <ComboBox Grid.Column="0"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                ItemsSource="{Binding Capture.Channels}"
                SelectedItem="{Binding Capture.SelectedChannel}"
                PlaceholderText="No audio endpoints found"
                MaxDropDownHeight="420"
                ToolTip.Tip="{Binding Capture.ChannelDetailText}">
        <ComboBox.SelectionBoxItemTemplate>
          <DataTemplate DataType="vm:ChannelOptionViewModel" x:DataType="vm:ChannelOptionViewModel">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}" VerticalAlignment="Center">
              <Border Classes="badge" Classes.loopback="{Binding IsLoopback}">
                <TextBlock Text="{Binding KindLabel}" />
              </Border>
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              <TextBlock Classes="caption" Text="default" IsVisible="{Binding IsDefault}" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.SelectionBoxItemTemplate>
        <ComboBox.ItemTemplate>
          <DataTemplate DataType="vm:ChannelOptionViewModel" x:DataType="vm:ChannelOptionViewModel">
            <StackPanel Spacing="{StaticResource Space1}">
              <TextBlock Classes="section"
                         Margin="0,4,0,2"
                         Text="{Binding GroupHeader}"
                         IsVisible="{Binding ShowGroupHeader}" />
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space3}">
                <Border Grid.Column="0" Classes="badge" Classes.loopback="{Binding IsLoopback}">
                  <TextBlock Text="{Binding KindLabel}" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="caption mono" Text="{Binding FormatText}" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Classes="caption"
                         Text="system default endpoint"
                         IsVisible="{Binding IsDefault}" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <Button Grid.Column="1"
              Classes="icon"
              VerticalAlignment="Center"
              Command="{Binding Capture.RefreshChannelsCommand}"
              ToolTip.Tip="Re-scan endpoints — devices come and go"
              Content="&#x21BB;" />

      <!-- ============ Pre-flight level meter ============ -->
      <StackPanel Grid.Column="2"
                  Orientation="Horizontal"
                  Spacing="{StaticResource Space3}"
                  VerticalAlignment="Center">
        <Border Background="{DynamicResource SurfaceSunken}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusSm}"
                Padding="{StaticResource PadTight}"
                VerticalAlignment="Center">
          <ItemsControl ItemsSource="{Binding Capture.Meter.Segments}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:MeterSegmentViewModel" x:DataType="vm:MeterSegmentViewModel">
                <Border Classes="led"
                        Classes.mid="{Binding IsMid}"
                        Classes.high="{Binding IsHigh}"
                        Opacity="{Binding IsLit, Converter={StaticResource LitOpacity}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <TextBlock Classes="mono caption"
                   Width="{StaticResource LevelTextWidth}"
                   VerticalAlignment="Center"
                   Text="{Binding Capture.Meter.LevelText}" />

        <!-- Trimmed to a chip; the full sentence is the tooltip. Appearing or disappearing can
             only change this row's WIDTH, never its height. -->
        <TextBlock Classes="caption"
                   Foreground="{DynamicResource WarningBase}"
                   VerticalAlignment="Center"
                   TextTrimming="None"
                   IsVisible="{Binding Capture.Meter.IsSilent}"
                   Text="no audio"
                   ToolTip.Tip="Nothing has been heard on this endpoint for several seconds — is this the device Teams plays through?" />
      </StackPanel>

      <!-- ============ Whisper model + reserved download strip ============ -->
      <Grid Grid.Column="3"
            VerticalAlignment="Center"
            ColumnDefinitions="Auto,Auto"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="{StaticResource Space2}"
            RowSpacing="{StaticResource Space1}">

        <ComboBox Grid.Row="0" Grid.Column="0"
                  Width="{StaticResource ModelComboWidth}"
                  VerticalAlignment="Center"
                  ItemsSource="{Binding Capture.Models}"
                  SelectedItem="{Binding Capture.SelectedModel}"
                  ToolTip.Tip="Which whisper weights decode this channel">
          <!-- The closed box shows the dot and the name only. Repeating the per-item status here
               ("not downloaded · 465 MB") squeezed the model's own name out of a 150px control,
               and StatusBarView already states it in full for the selected model. -->
          <ComboBox.SelectionBoxItemTemplate>
            <DataTemplate DataType="vm:ModelOptionViewModel" x:DataType="vm:ModelOptionViewModel">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}" VerticalAlignment="Center">
                <Ellipse Width="{StaticResource ModelDotSize}" Height="{StaticResource ModelDotSize}"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource SuccessBase}" IsVisible="{Binding IsDownloaded}" />
                <Ellipse Width="{StaticResource ModelDotSize}" Height="{StaticResource ModelDotSize}"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource TextMuted}" IsVisible="{Binding !IsDownloaded}" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.SelectionBoxItemTemplate>
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="vm:ModelOptionViewModel" x:DataType="vm:ModelOptionViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space3}">
                <Ellipse Grid.Column="0"
                         Width="{StaticResource ModelDotSize}" Height="{StaticResource ModelDotSize}"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource SuccessBase}" IsVisible="{Binding IsDownloaded}" />
                <Ellipse Grid.Column="0"
                         Width="{StaticResource ModelDotSize}" Height="{StaticResource ModelDotSize}"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource TextMuted}" IsVisible="{Binding !IsDownloaded}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="caption" Text="{Binding StatusText}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Download and Cancel share one cell, so they overlay instead of stacking: the swap
             changes neither the row's height nor its width. -->
        <Button Grid.Row="0" Grid.Column="1"
                Classes="icon"
                VerticalAlignment="Center"
                Content="&#x2193;"
                Command="{Binding Capture.DownloadModelCommand}"
                IsVisible="{Binding !Capture.IsDownloading}"
                ToolTip.Tip="Fetch the ggml weights for the selected model" />
        <Button Grid.Row="0" Grid.Column="1"
                Classes="icon"
                VerticalAlignment="Center"
                Content="&#x2715;"
                Command="{Binding Capture.DownloadModelCancelCommand}"
                IsVisible="{Binding Capture.IsDownloading}"
                ToolTip.Tip="Cancel the download" />

        <!--
          The strip's height is RESERVED, not collapsed. A model download takes minutes and the
          user must be able to watch it, but letting the progress row appear would change the
          capture bar's measured height mid-download — the reflow that resized the transcript
          ScrollViewer's viewport underneath a stationary offset. Toggle the content, keep the box.
        -->
        <Panel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
               Width="{StaticResource DownloadStripWidth}"
               Height="{StaticResource DownloadStripHeight}">
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="{StaticResource Space2}"
                VerticalAlignment="Center"
                IsVisible="{Binding Capture.IsDownloading}">
            <!-- MinWidth as well as Width: Fluent's ProgressBar theme carries a MinWidth of its
                 own, and MinWidth beats Width in Avalonia's measure clamp — leave it and the bar
                 swells to the theme's width, swallowing the status text's column whole. -->
            <ProgressBar Grid.Column="0"
                         Width="{StaticResource DownloadBarWidth}"
                         MinWidth="{StaticResource DownloadBarWidth}"
                         Height="{StaticResource DownloadBarHeight}"
                         VerticalAlignment="Center"
                         Minimum="0"
                         Maximum="1"
                         Value="{Binding Capture.DownloadFraction}"
                         IsIndeterminate="{Binding Capture.IsDownloadIndeterminate}" />
            <TextBlock Grid.Column="1"
                       Classes="caption"
                       VerticalAlignment="Center"
                       Text="{Binding Capture.DownloadStatusText}"
                       ToolTip.Tip="{Binding Capture.DownloadStatusText}" />
          </Grid>
        </Panel>
      </Grid>

      <!-- ============ Session metadata ============
           Disabled, not hidden, while rolling: the height must not move, and you should still
           be able to read what the session in progress is called. -->
      <TextBox Grid.Column="4"
               VerticalAlignment="Center"
               PlaceholderText="Session title"
               IsEnabled="{Binding !IsRecording}"
               Text="{Binding Capture.SessionTitle}"
               ToolTip.Tip="Names the session folder and the notes.md heading" />

      <TextBox Grid.Column="5"
               Width="{StaticResource ProjectWidth}"
               VerticalAlignment="Center"
               PlaceholderText="Project"
               IsEnabled="{Binding !IsRecording}"
               Text="{Binding Capture.Project}"
               ToolTip.Tip="Groups sessions — becomes the folder under the notes root" />

      <!-- ============ Transport ============ -->
      <StackPanel Grid.Column="6"
                  Orientation="Horizontal"
                  Spacing="{StaticResource Space3}"
                  VerticalAlignment="Center"
                  IsVisible="{Binding IsRecording}">
        <Ellipse Classes="pulse"
                 Width="{StaticResource RecordDotSize}"
                 Height="{StaticResource RecordDotSize}"
                 VerticalAlignment="Center"
                 Fill="{DynamicResource DangerBase}"
                 ToolTip.Tip="{Binding Capture.RecordingStateText}" />
        <TextBlock Classes="mono"
                   VerticalAlignment="Center"
                   FontSize="{StaticResource FontSizeLg}"
                   TextTrimming="None"
                   Text="{Binding Capture.ElapsedText}" />
      </StackPanel>

      <Button Grid.Column="7"
              Classes="record"
              Classes.rolling="{Binding IsRecording}"
              VerticalAlignment="Center"
              Content="{Binding RecordButtonText}"
              Command="{Binding ToggleRecordingCommand}"
              ToolTip.Tip="{Binding RecordButtonHint}" />
    </Grid>
  </Border>
</UserControl>
