<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:vm="using:NoteScribe.App.ViewModels"
             xmlns:views="using:NoteScribe.App.Views"
             mc:Ignorable="d"
             x:Class="NoteScribe.App.Views.NoteEditorView"
             x:DataType="vm:NoteEditorViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <!--
      The mode strip reuses Button.ghost and adds one state the shared sheet has no notion of:
      "this is the mode you are in". Same idiom as the app-wide selection - AccentMuted fill,
      TextPrimary label - so it reads as selection rather than as a second hover.
    -->
    <Style Selector="Button.mode.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBase}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.mode.on TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Background="{DynamicResource SurfaceBase}">

    <!-- ============================ toolbar ============================ -->
    <Border Grid.Row="0" Classes="toolbar" IsVisible="{Binding HasDocument}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space4}">

        <StackPanel Grid.Column="0" Spacing="{DynamicResource Space1}">
          <TextBox Text="{Binding DocumentTitle}"
                   PlaceholderText="Untitled note"
                   FontSize="{StaticResource FontSizeLg}"
                   FontWeight="SemiBold"
                   Padding="{DynamicResource PadTight}"
                   BorderThickness="0"
                   Background="Transparent"
                   AutomationProperties.Name="Note title" />

          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space3}" Margin="6,0,0,0">
            <TextBlock Classes="caption" Text="Project" VerticalAlignment="Center" />
            <TextBox Text="{Binding DocumentProject}"
                     PlaceholderText="none"
                     Width="150"
                     MinHeight="22"
                     FontSize="{StaticResource FontSizeXs}"
                     Padding="6,2"
                     AutomationProperties.Name="Project" />
            <TextBlock Classes="caption" Text="{Binding WordCountText}" VerticalAlignment="Center" />
            <TextBlock Classes="caption" Text="{Binding SelectionSummary}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Space3}" VerticalAlignment="Center">

          <TextBlock Classes="caption"
                     VerticalAlignment="Center"
                     Text="{Binding SaveStateText}"
                     ToolTip.Tip="Edits autosave after a short pause. Ctrl+S writes immediately." />

          <Ellipse Width="6" Height="6"
                   VerticalAlignment="Center"
                   Fill="{DynamicResource WarningBase}"
                   IsVisible="{Binding IsDirty}"
                   ToolTip.Tip="Unsaved changes" />

          <Border Background="{DynamicResource SurfaceSunken}"
                  BorderBrush="{DynamicResource BorderSubtle}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource RadiusSm}"
                  Padding="2">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="ghost mode"
                      Classes.on="{Binding IsEditorOnly}"
                      Content="Edit"
                      Command="{Binding ShowEditorCommand}"
                      ToolTip.Tip="Editor only" />
              <Button Classes="ghost mode"
                      Classes.on="{Binding IsSplit}"
                      Content="Split"
                      Command="{Binding ShowSplitCommand}"
                      ToolTip.Tip="Editor and preview side by side" />
              <Button Classes="ghost mode"
                      Classes.on="{Binding IsPreviewOnly}"
                      Content="Preview"
                      Command="{Binding ShowPreviewCommand}"
                      ToolTip.Tip="Rendered markdown only" />
            </StackPanel>
          </Border>

          <Button Classes="subtle"
                  Content="Save"
                  Command="{Binding SaveCommand}"
                  ToolTip.Tip="Ctrl+S — writes a revision so this state is always recoverable" />

          <Button Classes="ai"
                  Content="✦ Assistant"
                  Command="{Binding ToggleSidePaneCommand}"
                  ToolTip.Tip="Show or hide the assistant and revision history" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================ panes ============================ -->
    <Grid Grid.Row="1" Name="PaneGrid" ColumnDefinitions="*,Auto,*" IsVisible="{Binding HasDocument}">

      <Border Grid.Column="0"
              Name="EditorHost"
              Background="{DynamicResource EditorBackground}"
              IsVisible="{Binding IsEditorVisible}">
        <ae:TextEditor Name="Editor"
                       ShowLineNumbers="True"
                       WordWrap="True"
                       Padding="{DynamicResource PadCard}"
                       Background="{DynamicResource EditorBackground}"
                       Foreground="{DynamicResource TextPrimary}"
                       LineNumbersForeground="{DynamicResource EditorLineNumber}"
                       FontFamily="{DynamicResource FontFamilyMono}"
                       FontSize="{DynamicResource FontSizeMd}"
                       HorizontalScrollBarVisibility="Disabled"
                       VerticalScrollBarVisibility="Auto"
                       AutomationProperties.Name="Note body">
          <ae:TextEditor.Options>
            <ae:TextEditorOptions ConvertTabsToSpaces="True"
                                  IndentationSize="4"
                                  HighlightCurrentLine="True"
                                  AllowScrollBelowDocument="True"
                                  EnableHyperlinks="False"
                                  EnableEmailHyperlinks="False"
                                  ShowSpaces="False"
                                  ShowTabs="False" />
          </ae:TextEditor.Options>
        </ae:TextEditor>
      </Border>

      <GridSplitter Grid.Column="1"
                    Width="3"
                    Background="{DynamicResource BorderSubtle}"
                    IsVisible="{Binding IsSplit}"
                    ResizeDirection="Columns" />

      <Border Grid.Column="2"
              Background="{DynamicResource SurfaceBase}"
              BorderBrush="{DynamicResource BorderSubtle}"
              BorderThickness="1,0,0,0"
              IsVisible="{Binding IsPreviewVisible}">
        <ScrollViewer Padding="{DynamicResource PadPane}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <views:MarkdownPreview Markdown="{Binding PreviewMarkdown}" MaxWidth="820" HorizontalAlignment="Left" />
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- ============================ empty state ============================ -->
    <StackPanel Grid.Row="1"
                Spacing="{DynamicResource Space4}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="380"
                IsVisible="{Binding !HasDocument}">
      <TextBlock Classes="h2" Text="No note open" HorizontalAlignment="Center" TextTrimming="None" />
      <TextBlock Classes="caption"
                 TextWrapping="Wrap"
                 TextTrimming="None"
                 TextAlignment="Center"
                 Text="Pick a note on the left, start a new one, or seed one from a finished meeting. Everything you write here is versioned — the assistant can never overwrite something you cannot get back." />
    </StackPanel>
  </Grid>
</UserControl>
