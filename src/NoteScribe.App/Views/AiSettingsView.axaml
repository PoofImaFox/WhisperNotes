<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NoteScribe.App.ViewModels"
             mc:Ignorable="d"
             x:Class="NoteScribe.App.Views.AiSettingsView"
             x:DataType="vm:AiSettingsViewModel">

  <Border Background="{DynamicResource AiAccentMuted}"
          BorderBrush="{DynamicResource BorderDefault}"
          BorderThickness="0,1,0,1"
          Padding="{DynamicResource PadCard}">
    <StackPanel Spacing="{DynamicResource Space3}">

      <TextBlock Classes="label" Text="ASSISTANT" />

      <!-- provider -->
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
        <RadioButton GroupName="AiProvider"
                     Content="Ollama (local)"
                     IsChecked="{Binding IsOllama}"
                     ToolTip.Tip="Runs on this machine. Note text never leaves it." />
        <RadioButton GroupName="AiProvider"
                     Content="Anthropic"
                     IsChecked="{Binding IsAnthropic}"
                     ToolTip.Tip="Hosted. Sends the note text you point an action at off this machine." />
      </StackPanel>

      <!-- ollama -->
      <StackPanel Spacing="{DynamicResource Space2}" IsVisible="{Binding IsOllama}">
        <TextBlock Classes="caption" Text="Endpoint" />
        <TextBox Text="{Binding OllamaEndpoint}" PlaceholderText="http://localhost:11434" />
        <TextBlock Classes="caption" Text="Model" Margin="0,4,0,0" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space2}">
          <TextBox Grid.Column="0" Text="{Binding OllamaModel}" PlaceholderText="llama3.1" />
          <Button Grid.Column="1"
                  Classes="subtle"
                  Content="Refresh"
                  Command="{Binding RefreshModelsCommand}"
                  IsEnabled="{Binding !IsRefreshingModels}"
                  ToolTip.Tip="Ask the provider which models it has" />
        </Grid>
      </StackPanel>

      <!-- anthropic -->
      <StackPanel Spacing="{DynamicResource Space2}" IsVisible="{Binding IsAnthropic}">
        <TextBlock Classes="caption" Text="Model" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space2}">
          <TextBox Grid.Column="0" Text="{Binding AnthropicModel}" PlaceholderText="claude-opus-5" />
          <Button Grid.Column="1"
                  Classes="subtle"
                  Content="Refresh"
                  Command="{Binding RefreshModelsCommand}"
                  IsEnabled="{Binding !IsRefreshingModels}" />
        </Grid>
        <TextBlock Classes="caption" Text="API key" Margin="0,4,0,0" />
        <TextBox Text="{Binding AnthropicApiKey}"
                 PasswordChar="•"
                 PlaceholderText="sk-ant-… or leave blank to use ANTHROPIC_API_KEY"
                 AutomationProperties.Name="Anthropic API key" />
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   TextTrimming="None"
                   Text="Stored in your settings file. It is never written to a log or shown in a notification." />
      </StackPanel>

      <!-- discovered models -->
      <StackPanel Spacing="{DynamicResource Space2}" IsVisible="{Binding HasModels}">
        <TextBlock Classes="caption" Text="Available on this provider" />
        <ComboBox ItemsSource="{Binding AvailableModels}"
                  SelectedItem="{Binding SelectedDiscoveredModel}"
                  HorizontalAlignment="Stretch"
                  PlaceholderText="pick a discovered model"
                  AutomationProperties.Name="Discovered models" />
      </StackPanel>

      <TextBlock Classes="caption"
                 TextWrapping="Wrap"
                 TextTrimming="None"
                 Text="{Binding ModelsHint}"
                 IsVisible="{Binding HasModelsHint}" />

      <!-- budget -->
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space3}">
        <TextBlock Grid.Column="0" Classes="caption" Text="Max output tokens" VerticalAlignment="Center" />
        <TextBox Grid.Column="1"
                 Text="{Binding MaxOutputTokensText}"
                 Width="90"
                 HorizontalAlignment="Left"
                 AutomationProperties.Name="Max output tokens" />
      </Grid>

      <!-- not-configured hint -->
      <Border Background="{DynamicResource WarningMuted}"
              BorderBrush="{DynamicResource WarningBase}"
              BorderThickness="1"
              CornerRadius="{DynamicResource RadiusSm}"
              Padding="{DynamicResource PadTight}"
              IsVisible="{Binding HasConfigurationHint}">
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   TextTrimming="None"
                   Foreground="{DynamicResource WarningBase}"
                   Text="{Binding ConfigurationHint}" />
      </Border>
    </StackPanel>
  </Border>
</UserControl>
