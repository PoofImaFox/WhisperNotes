<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NoteScribe.App.ViewModels"
             xmlns:views="using:NoteScribe.App.Views"
             mc:Ignorable="d"
             x:Class="NoteScribe.App.Views.NotesWorkspaceView"
             x:DataType="vm:NotesWorkspaceViewModel">

  <UserControl.Styles>
    <!-- Library rows: the app-wide selection idiom, applied to a Border rather than the container
         so the whole row (metadata included) comes up to full contrast when picked. -->
    <Style Selector="Border.noterow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    </Style>
    <Style Selector="Border.noterow:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentSubtle}" />
    </Style>
    <Style Selector="Border.noterow.picked">
      <Setter Property="Background" Value="{DynamicResource AccentMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBase}" />
    </Style>
    <Style Selector="Border.noterow.picked TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <!-- Assistant tab strip — same selection language as everything else. -->
    <Style Selector="Button.tab.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBase}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.tab.on TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style Selector="Button.action">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    </Style>
    <Style Selector="Button.action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AiAccentMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AiAccent}" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <Grid ColumnDefinitions="252,Auto,*,Auto,Auto">

      <!-- ================================================================
           LIBRARY
           ================================================================ -->
      <Border Grid.Column="0"
              Background="{DynamicResource SurfaceSunken}"
              BorderBrush="{DynamicResource BorderDefault}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

          <Grid Grid.Row="0"
                ColumnDefinitions="*,Auto,Auto"
                Margin="12,12,10,8"
                ColumnSpacing="{DynamicResource Space2}">
            <TextBlock Grid.Column="0" Classes="label" Text="NOTES" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="ghost"
                    Padding="{DynamicResource PadTight}"
                    Content="Folder"
                    Command="{Binding OpenNotesFolderCommand}"
                    ToolTip.Tip="Reveal the note documents folder in Explorer" />
            <Button Grid.Column="2"
                    Classes="ghost"
                    Padding="{DynamicResource PadTight}"
                    Content="Reload"
                    Command="{Binding ReloadCommand}" />
          </Grid>

          <Grid Grid.Row="1"
                ColumnDefinitions="*,Auto"
                Margin="12,0,10,8"
                ColumnSpacing="{DynamicResource Space2}">
            <Button Grid.Column="0"
                    Classes="accent"
                    HorizontalAlignment="Stretch"
                    Content="New note"
                    Command="{Binding NewNoteCommand}" />
            <Button Grid.Column="1"
                    Classes="subtle"
                    Content="From meeting…"
                    Command="{Binding NewFromMeetingCommand}"
                    ToolTip.Tip="Seed a note from a finished recording's transcript" />
          </Grid>

          <TextBox Grid.Row="2"
                   Margin="12,0,10,8"
                   PlaceholderText="Search titles, projects and text…"
                   Text="{Binding SearchText}"
                   AutomationProperties.Name="Search notes" />

          <!-- inline rename + delete confirmation, in place of a modal dialog -->
          <StackPanel Grid.Row="3" Margin="12,0,10,8" Spacing="{DynamicResource Space2}">
            <StackPanel Spacing="{DynamicResource Space2}" IsVisible="{Binding IsRenaming}">
              <TextBlock Classes="caption" Text="Rename" />
              <TextBox Text="{Binding RenameText}" AutomationProperties.Name="New title">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding CommitRenameCommand}" />
                  <KeyBinding Gesture="Escape" Command="{Binding CancelRenameCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
                <Button Classes="accent" Content="Rename" Command="{Binding CommitRenameCommand}" />
                <Button Classes="subtle" Content="Cancel" Command="{Binding CancelRenameCommand}" />
              </StackPanel>
            </StackPanel>

            <Border Background="{DynamicResource DangerMuted}"
                    BorderBrush="{DynamicResource DangerBase}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSm}"
                    Padding="{DynamicResource PadTight}"
                    IsVisible="{Binding IsDeleteConfirmOpen}">
              <StackPanel Spacing="{DynamicResource Space2}">
                <TextBlock Classes="caption"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           Text="{Binding DeleteConfirmText}" />
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
                  <Button Classes="danger" Content="Delete" Command="{Binding ConfirmDeleteCommand}" />
                  <Button Classes="subtle" Content="Keep" Command="{Binding CancelDeleteCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <ListBox Grid.Row="4"
                   Margin="6,0,6,0"
                   Background="Transparent"
                   BorderThickness="0"
                   ItemsSource="{Binding Documents}"
                   SelectedItem="{Binding SelectedDocument}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="Note library">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="MinHeight" Value="0" />
              </Style>
              <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
              </Style>
            </ListBox.Styles>

            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:NoteListItemViewModel">
                <Border Classes="noterow"
                        Classes.picked="{Binding $parent[ListBoxItem].IsSelected}"
                        AutomationProperties.Name="{Binding Title}">
                  <StackPanel Spacing="{DynamicResource Space1}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space2}">
                      <Ellipse Grid.Column="0"
                               Width="6" Height="6"
                               VerticalAlignment="Center"
                               Fill="{DynamicResource AiAccent}"
                               IsVisible="{Binding IsAiTouched}"
                               ToolTip.Tip="The most recent change came from an AI action" />
                      <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="Medium" />
                    </Grid>

                    <TextBlock Classes="caption" Text="{Binding PreviewText}" IsVisible="{Binding HasPreview}" />

                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space3}">
                      <Border Classes="badge" IsVisible="{Binding HasProject}">
                        <TextBlock Text="{Binding ProjectText}" />
                      </Border>
                      <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding UpdatedText}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="5"
                  BorderBrush="{DynamicResource BorderSubtle}"
                  BorderThickness="0,1,0,0"
                  Padding="{DynamicResource PadCard}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Space2}">
              <TextBlock Grid.Column="0" Classes="caption" Text="{Binding LibrarySummary}" VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Classes="ghost"
                      Padding="{DynamicResource PadTight}"
                      Content="Rename"
                      Command="{Binding BeginRenameCommand}" />
              <Button Grid.Column="2"
                      Classes="ghost"
                      Padding="{DynamicResource PadTight}"
                      Content="Delete"
                      Command="{Binding RequestDeleteCommand}" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="3" Background="{DynamicResource BorderSubtle}" ResizeDirection="Columns" />

      <!-- ================================================================
           EDITOR
           ================================================================ -->
      <views:NoteEditorView Grid.Column="2" DataContext="{Binding Editor}" />

      <GridSplitter Grid.Column="3"
                    Width="3"
                    Background="{DynamicResource BorderSubtle}"
                    ResizeDirection="Columns"
                    IsVisible="{Binding Editor.IsSidePaneOpen}" />

      <!-- ================================================================
           ASSISTANT + HISTORY RAIL
           ================================================================ -->
      <Border Grid.Column="4"
              Width="336"
              Background="{DynamicResource SurfaceBase}"
              BorderBrush="{DynamicResource BorderDefault}"
              BorderThickness="1,0,0,0"
              IsVisible="{Binding Editor.IsSidePaneOpen}">
        <Grid RowDefinitions="Auto,Auto,*">

          <!-- tab strip -->
          <Border Grid.Row="0" Classes="toolbar">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource Space2}">
              <Button Grid.Column="0"
                      Classes="ghost tab"
                      Classes.on="{Binding Editor.IsAssistantPane}"
                      Content="Assistant"
                      Command="{Binding Editor.ShowAssistantCommand}" />
              <Button Grid.Column="1"
                      Classes="ghost tab"
                      Classes.on="{Binding Editor.IsHistoryPane}"
                      Content="History"
                      Command="{Binding Editor.ShowHistoryCommand}" />
              <Button Grid.Column="3"
                      Classes="icon"
                      Content="⚙"
                      Command="{Binding ToggleAiSettingsCommand}"
                      ToolTip.Tip="Assistant settings" />
              <Button Grid.Column="4"
                      Classes="icon"
                      Content="✕"
                      Command="{Binding Editor.ToggleSidePaneCommand}"
                      ToolTip.Tip="Hide this panel" />
            </Grid>
          </Border>

          <views:AiSettingsView Grid.Row="1"
                                DataContext="{Binding AiSettings}"
                                IsVisible="{Binding $parent[views:NotesWorkspaceView].((vm:NotesWorkspaceViewModel)DataContext).IsAiSettingsOpen}" />

          <!-- ================= assistant ================= -->
          <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto" IsVisible="{Binding Editor.IsAssistantPane}">

            <StackPanel Grid.Row="0" Margin="{DynamicResource PadCard}" Spacing="{DynamicResource Space2}">
              <TextBlock Classes="caption" Text="{Binding AiSettings.ProviderSummary}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="caption"
                         Foreground="{DynamicResource WarningBase}"
                         TextWrapping="Wrap"
                         TextTrimming="None"
                         Text="{Binding AiSettings.ConfigurationHint}"
                         IsVisible="{Binding AiSettings.HasConfigurationHint}" />

              <TextBox Text="{Binding Editor.CustomInstruction}"
                       PlaceholderText="Instruction for “Custom instruction…”"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MaxHeight="86"
                       AutomationProperties.Name="Custom instruction" />

              <TextBlock Classes="caption">
                <Run Text="Actions run against the" />
                <Run Text="{Binding Editor.TargetText}" FontWeight="SemiBold" />
                <Run Text="and land in a preview first." />
              </TextBlock>
            </StackPanel>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Editor.ActionGroups}" Margin="10,0,10,10">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:AiActionGroupViewModel">
                    <StackPanel Spacing="{DynamicResource Space2}" Margin="0,0,0,10">
                      <TextBlock Classes="section" Text="{Binding CategoryText}" />
                      <ItemsControl ItemsSource="{Binding Actions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:AiActionViewModel">
                            <Button Classes="ghost action"
                                    Margin="0,0,0,3"
                                    Command="{Binding RunCommand}"
                                    ToolTip.Tip="{Binding TooltipText}"
                                    AutomationProperties.Name="{Binding Name}">
                              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Space3}">
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" VerticalAlignment="Center" TextTrimming="None" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Classes="caption"
                                           VerticalAlignment="Center"
                                           Text="running…"
                                           IsVisible="{Binding IsRunning}" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- ================= preview → apply ================= -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceSunken}"
                    BorderBrush="{DynamicResource AiAccent}"
                    BorderThickness="0,2,0,0"
                    MaxHeight="420"
                    IsVisible="{Binding Editor.HasPreview}">
              <Grid RowDefinitions="Auto,*,Auto,Auto">
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="{DynamicResource PadCard}"
                      ColumnSpacing="{DynamicResource Space2}">
                  <TextBlock Grid.Column="0"
                             Classes="label"
                             Foreground="{DynamicResource AiAccent}"
                             Text="{Binding Editor.PreviewHeader}" />
                  <Button Grid.Column="1"
                          Classes="danger"
                          Padding="{DynamicResource PadTight}"
                          Content="Stop"
                          Command="{Binding Editor.StopCommand}"
                          IsVisible="{Binding Editor.IsRunning}" />
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Padding="12,0,12,8"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                  <SelectableTextBlock Text="{Binding Editor.PreviewText}"
                                       TextWrapping="Wrap"
                                       FontFamily="{DynamicResource FontFamilyMono}"
                                       FontSize="{StaticResource FontSizeSm}"
                                       Foreground="{DynamicResource TextPrimary}" />
                </ScrollViewer>

                <TextBlock Grid.Row="2"
                           Classes="caption"
                           Margin="12,0,12,6"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           Foreground="{DynamicResource WarningBase}"
                           Text="{Binding Editor.PreviewNote}"
                           IsVisible="{Binding Editor.PreviewNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            Spacing="{DynamicResource Space2}"
                            Margin="{DynamicResource PadCard}">
                  <Button Classes="accent"
                          Content="Apply"
                          Command="{Binding Editor.ApplyPreviewCommand}"
                          ToolTip.Tip="Replace the target text. The previous version goes straight into History." />
                  <Button Classes="subtle"
                          Content="Insert below"
                          Command="{Binding Editor.InsertPreviewCommand}"
                          ToolTip.Tip="Keep the original and add this underneath it" />
                  <Button Classes="ghost" Content="Copy" Command="{Binding Editor.CopyPreviewCommand}" />
                  <Button Classes="ghost" Content="Discard" Command="{Binding Editor.DiscardPreviewCommand}" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>

          <!-- ================= history ================= -->
          <views:NoteRevisionsView Grid.Row="2"
                                   DataContext="{Binding Editor}"
                                   IsVisible="{Binding IsHistoryPane}" />
        </Grid>
      </Border>
    </Grid>

    <!-- ================================================================
         MEETING PICKER — an overlay, so it never resizes the panes beneath
         ================================================================ -->
    <Border Background="#B00F1115" IsVisible="{Binding IsMeetingPickerOpen}">
      <Border Classes="pane"
              Width="520"
              MaxHeight="460"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="{DynamicResource SurfaceOverlay}">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource Space4}">
          <StackPanel Grid.Row="0" Spacing="{DynamicResource Space1}">
            <TextBlock Classes="h2" Text="New note from a meeting" TextTrimming="None" />
            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       TextTrimming="None"
                       Text="The session's rendered transcript becomes the note's starting text, and the note remembers which meeting it came from." />
          </StackPanel>

          <ListBox Grid.Row="1"
                   Background="Transparent"
                   BorderThickness="0"
                   ItemsSource="{Binding Meetings}"
                   SelectedItem="{Binding SelectedMeeting}"
                   AutomationProperties.Name="Finished meetings">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:MeetingPickViewModel">
                <StackPanel Spacing="{DynamicResource Space1}" Margin="0,2">
                  <TextBlock Text="{Binding Title}" FontWeight="Medium" />
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space3}">
                    <TextBlock Classes="caption" Text="{Binding WhenText}" />
                    <TextBlock Classes="caption" Text="{Binding DurationText}" />
                    <TextBlock Classes="caption" Text="{Binding ProjectText}" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="{DynamicResource Space3}" HorizontalAlignment="Right">
            <TextBlock Classes="caption" Text="loading…" VerticalAlignment="Center" IsVisible="{Binding IsMeetingsLoading}" />
            <Button Classes="subtle" Content="Cancel" Command="{Binding CloseMeetingPickerCommand}" />
            <Button Classes="accent" Content="Create note" Command="{Binding CreateFromMeetingCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>
  </Panel>
</UserControl>
