root = true

# ======================================================================================
#  WhisperNotes code-quality gate
#
#  +------------------------------------------------------------------------------+
#  | *** FLIP TO ERROR ***                                                         |
#  |                                                                               |
#  | Every rule in the "GATE" sections below is currently `warning` so that the     |
#  | build still succeeds while the existing violations are being worked through.  |
#  | To make the gate hard-fail, replace `= warning` with `= error` in this file:   |
#  |                                                                               |
#  |     sed -i 's/\.severity = [w]arning/.severity = error/' .editorconfig        |
#  |                                                                               |
#  | (The [w] is a one-character class so this comment does not rewrite itself.)    |
#  |                                                                               |
#  | Do NOT do it by turning on TreatWarningsAsErrors - that would also promote     |
#  | unrelated compiler/NuGet warnings and break the build for the wrong reasons.   |
#  +------------------------------------------------------------------------------+
#
#  Threshold semantics (verified empirically against the analyzers in SDK 10.0.301,
#  not taken on faith):
#    * `dotnet_code_quality.CA1502.threshold` is NOT a real option. Setting it here is
#      silently ignored and CA1502 keeps its default threshold of 25. The thresholds
#      live in ./CodeMetricsConfig.txt, wired in via Directory.Build.props.
#    * CA1502 fires when complexity is STRICTLY GREATER than the threshold, so the
#      configured value of 15 means "at most 15"; the first reported value is 16.
# ======================================================================================

[*]
indent_style = space
insert_final_newline = true
charset = utf-8-bom
trim_trailing_whitespace = true

[*.{csproj,props,targets,axaml,xaml,xml,config}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# --------------------------------------------------------------------------------------
#  Generated code - excluded from the gate.
#
#  Roslyn already auto-detects a file as generated when it is named *.g.cs / *.g.i.cs /
#  *.designer.cs / *.generated.cs / *AssemblyInfo.cs / TemporaryGeneratedFile_*, or when
#  it carries an <auto-generated/> header or a [GeneratedCode] attribute. That covers the
#  CommunityToolkit.Mvvm source-generator partials ([ObservableProperty]/[RelayCommand]),
#  the Avalonia XAML InitializeComponent partials, and everything under obj/.
#
#  These sections restate it explicitly so the exclusion is a documented decision rather
#  than an implementation detail we happen to be relying on, and so it survives a change
#  in generator file-naming.
#
#  Do NOT add a `[*.cs] generated_code = false` catch-all below these. `*.g.cs` also
#  matches `*.cs`, later sections win in EditorConfig, and the catch-all would therefore
#  force every generated file back INTO the gate - and would additionally defeat Roslyn's
#  <auto-generated/>-header and [GeneratedCode]-attribute detection, which is the only
#  thing that covers generator output whose synthesized path no .editorconfig glob can
#  match. Leaving the option unset for ordinary source is what we want: it means "decide
#  automatically", which is correct for hand-written code.
# --------------------------------------------------------------------------------------

[*.{g,i,designer,generated}.cs]
generated_code = true

[*.g.i.cs]
generated_code = true

[*{AssemblyInfo,AssemblyAttributes,GlobalUsings}.cs]
generated_code = true

[TemporaryGeneratedFile_*.cs]
generated_code = true

# Belt and braces: anything that ends up under obj/ or bin/ is build output.
[**/{obj,bin}/**.cs]
generated_code = true


# ======================================================================================
#  C# analyzer configuration
# ======================================================================================
[*.cs]

# ======================================================================================
#  GATE 1 - CODE METRICS  (all four are OFF by default; thresholds in CodeMetricsConfig.txt)
# ======================================================================================

# CA1502: Avoid excessive complexity.
#   THE headline gate. Threshold 15 (see CodeMetricsConfig.txt) => a method may be at
#   most 15; 16 reports. Cyclomatic complexity is the single best cheap proxy for
#   "nobody can hold this method in their head or test all its paths".
dotnet_diagnostic.CA1502.severity = error

# CA1505: Avoid unmaintainable code (maintainability index < 10).
#   Composite of complexity + Halstead volume + lines. Catches methods that are long and
#   dense but *not* especially branchy, which CA1502 alone would wave through.
dotnet_diagnostic.CA1505.severity = error

# CA1506: Avoid excessive class coupling.
#   Number of distinct types a type/member depends on. This is the god-object detector -
#   directly relevant to the view models and the DI composition root here.
dotnet_diagnostic.CA1506.severity = error

# CA1501: Avoid excessive inheritance (depth > 5).
#   Kept at the default threshold of 5, which is the useful setting for code where we own
#   the hierarchy (Core, Cli, view models). It is switched OFF for src/WhisperNotes.App/Views
#   further down: an Avalonia UserControl is already 11 levels deep and a Window 13, purely
#   inside the framework, so every view reports and no amount of refactoring can fix it.
#   The alternative - raising the global threshold to 13 in CodeMetricsConfig.txt - was
#   rejected because it would neuter the rule everywhere else too.
dotnet_diagnostic.CA1501.severity = error

# CA1509: Invalid entry in code metrics configuration file.
#   Promoted to warning so a typo in CodeMetricsConfig.txt is loud instead of silently
#   reverting a threshold to its default. Flip this one to `error` with the rest.
dotnet_diagnostic.CA1509.severity = error


# ======================================================================================
#  GATE 2 - CODE SMELLS THAT INDICATE REAL BUGS
#
#  Chosen deliberately. The bar for inclusion: the rule must point at something that is
#  either a latent bug or genuinely unmaintainable, and a fix must be a real improvement
#  rather than a reshuffle. Rules that would only generate churn are listed - and
#  justified - in the "DELIBERATELY OFF" section further down.
# ======================================================================================

# ---- Dead / unreachable logic ---------------------------------------------------------

# CA1508: Avoid dead conditional code. (off by default; dataflow analysis)
#   Flags conditions that are provably always-true/always-false. In a nullable-enabled
#   codebase these are almost always a stale null check left behind by a refactor, or a
#   guard that is silently not guarding anything. Highest-signal rule in this list.
dotnet_diagnostic.CA1508.severity = error

# IDE0051 / IDE0052: unused and write-only private members. Straight dead code.
dotnet_diagnostic.IDE0051.severity = error
dotnet_diagnostic.IDE0052.severity = error

# IDE0059: value assigned to a variable is never read. Usually a dropped result or a
#   half-finished refactor; occasionally an actual swallowed return value.
dotnet_diagnostic.IDE0059.severity = error

# CA1806: Do not ignore method results - the "you called it and threw the answer away"
#   bug, e.g. a bare `int.Parse(s);` or an unused `string.Replace` result.
dotnet_diagnostic.CA1806.severity = error

# ---- Async / cancellation correctness -------------------------------------------------
# This app is async top to bottom (WASAPI capture -> whisper -> UI), so async defects
# here surface as hangs and un-cancellable recordings, not as compile errors.

# CA2016: Forward the CancellationToken parameter to methods that take one.
#   Directly prevents "Stop doesn't actually stop" bugs in the capture/transcription
#   pipeline. Nearly zero false positives.
dotnet_diagnostic.CA2016.severity = error

# CA1849: Call async methods when in an async method (no .Result/.Wait()/Thread.Sleep).
#   Sync-over-async on the Avalonia UI thread is a deadlock, not a slowdown.
dotnet_diagnostic.CA1849.severity = error

# CA2012: Use ValueTasks correctly (never await/consume one twice).
dotnet_diagnostic.CA2012.severity = error

# ---- Resource lifetime ----------------------------------------------------------------
# Native handles everywhere: whisper.cpp contexts, ONNX sessions, WASAPI clients,
# file streams. Leaks here are process-lifetime leaks of unmanaged memory.

# CA2000: Dispose objects before losing scope. (off by default)
#   Known to over-report when ownership is deliberately transferred to a caller or to a
#   DI container. Kept because the true positives are expensive, but every hit needs a
#   human read - expect some of these to be resolved with a targeted suppression rather
#   than a code change.
dotnet_diagnostic.CA2000.severity = error

# CA2213: Disposable fields should be disposed. (off by default)
dotnet_diagnostic.CA2213.severity = error

# CA1063: Implement IDisposable correctly.
# CA1816: Call GC.SuppressFinalize correctly.
# CA2215: Dispose methods should call base class Dispose.
#   The three halves of "the dispose pattern is actually right".
dotnet_diagnostic.CA1063.severity = error
dotnet_diagnostic.CA1816.severity = error
dotnet_diagnostic.CA2215.severity = error

# ---- Enumeration / collection hazards -------------------------------------------------

# CA1851: Possible multiple enumerations of IEnumerable. (off by default)
#   With lazy sequences over audio frames and transcript segments this is a correctness
#   *and* a performance bug, not a micro-optimisation.
dotnet_diagnostic.CA1851.severity = error

# CA1854: Prefer TryGetValue over ContainsKey + indexer. Double lookup, and the pattern
#   it replaces is a classic race in concurrently-mutated dictionaries.
dotnet_diagnostic.CA1854.severity = error

# CA1860: Prefer .Count/.Length over Enumerable.Any() for emptiness checks.
dotnet_diagnostic.CA1860.severity = error

# ---- String comparison ----------------------------------------------------------------

# CA1862: Use StringComparison overloads instead of ToLower()/ToUpper() to compare.
#   Both a correctness fix (Turkish-I) and an allocation removed. This repo does file
#   extension and speaker-label matching, exactly where this bites.
dotnet_diagnostic.CA1862.severity = error

# CA1866: Use char overload of StartsWith/EndsWith for single characters.
dotnet_diagnostic.CA1866.severity = error

# ---- Exception hygiene ----------------------------------------------------------------

# CA2201: Do not raise reserved exception types (Exception, SystemException, ...) -
#   makes the exception impossible for a caller to handle selectively.
dotnet_diagnostic.CA2201.severity = error

# CA2208: Instantiate argument exceptions correctly (paramName actually set, and set to a
#   real parameter). Silent-but-useless diagnostics otherwise.
dotnet_diagnostic.CA2208.severity = error


# ======================================================================================
#  DELIBERATELY OFF - considered and rejected
#
#  Recorded here so nobody has to re-derive the reasoning, and so "why isn't X on?" has
#  an answer. These are all OFF by default already; the explicit `none` documents intent.
# ======================================================================================

# CA2007: Do not directly await a Task without ConfigureAwait(false).
#   Actively WRONG for this repo. Avalonia view models must resume on the UI thread;
#   ConfigureAwait(false) everywhere would introduce cross-thread UI access bugs.
dotnet_diagnostic.CA2007.severity = none

# CA1062: Validate arguments of public methods.
#   Redundant. <Nullable>enable</Nullable> is on repo-wide, so the compiler already
#   enforces this statically. Turning it on would mean hand-writing null guards the type
#   system has already proven unnecessary.
dotnet_diagnostic.CA1062.severity = none

# CA1303: Do not pass literals as localized parameters.
#   The app is single-locale English. Every CLI message would need a resource entry for
#   zero user-visible benefit.
dotnet_diagnostic.CA1303.severity = none

# CA1031: Do not catch general exception types.
#   Catch-all handlers at the CLI/UI boundary and around plugin-ish native calls
#   (whisper.cpp, ONNX, ffmpeg) are the correct design here - the alternative is a
#   crashed app on a malformed media file.
dotnet_diagnostic.CA1031.severity = none

# CA1848: Use the LoggerMessage delegates.
#   Pure allocation micro-optimisation. Would rewrite every log call site in the repo and
#   make them materially harder to read for savings that do not matter at this log volume.
dotnet_diagnostic.CA1848.severity = none

# CA1812: Avoid uninstantiated internal classes.
#   False-positives on anything constructed only through the DI container or by the
#   Avalonia XAML loader.
dotnet_diagnostic.CA1812.severity = none

# CA1859 / CA1860-adjacent "use concrete type" and CA1852 "seal internal types".
#   Opinionated perf-shape rules that trade API flexibility for gains that are noise at
#   this scale, and that fight the interface-driven design used for testability here.
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1852.severity = none

# CA1707: Identifiers should not contain underscores.
#   Would force renaming every `Method_Condition_Expectation` xUnit test.
dotnet_diagnostic.CA1707.severity = none

# IDE0005: Remove unnecessary using directives.
#   Genuinely useful, but in an MSBuild build it only reports when
#   <GenerateDocumentationFile>true</GenerateDocumentationFile> is set, which in turn
#   switches on CS1591 "missing XML comment" across the whole repo. Not worth that trade
#   right now; the IDE still surfaces it interactively.
dotnet_diagnostic.IDE0005.severity = none


# ======================================================================================
#  Avalonia view code-behind
#
#  Controls here derive from the framework, not from us: UserControl is 11 levels deep
#  and Window 13 before a single line of our code exists. CA1501 is unfixable there, so
#  it is off for this directory only - it stays at full strength (threshold 5) for every
#  hierarchy we actually own.
# ======================================================================================
[src/WhisperNotes.App/Views/**.cs]
dotnet_diagnostic.CA1501.severity = none


# ======================================================================================
#  Test project relaxations
#
#  Tests are allowed to be blunt: they construct throwaway disposables, assert on
#  literals, and name methods with underscores.
# ======================================================================================
[tests/**/*.cs]
dotnet_diagnostic.CA1502.severity = suggestion
dotnet_diagnostic.CA1505.severity = suggestion
dotnet_diagnostic.CA1506.severity = none
dotnet_diagnostic.CA2000.severity = none
dotnet_diagnostic.CA1508.severity = suggestion
dotnet_diagnostic.CA2007.severity = none
